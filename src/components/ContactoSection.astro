---
/**
 * ContactoSection — Dark Luxe Contact Section.
 *
 * Features:
 *   - Simplified header text
 *   - Dark contact cards with golden accents
 *   - Live hours from Google Places API (falls back to static if API not configured)
 *   - Map & call CTA
 */
import Button from './Button.astro';

// Google Places API config (set in .env)
const googleApiKey = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY ?? '';
const googlePlaceId = import.meta.env.PUBLIC_GOOGLE_PLACE_ID ?? '';

const contactInfo = {
  address: {
    street: 'C. Juego Pelotas, n°2, 1° Derecha',
    city: '23740 Andújar, Jaén',
    gmapsUrl: 'https://maps.google.com/?q=C.+Juego+Pelotas,+2,+23740+And%C3%BAjar,+Ja%C3%A9n',
  },
  phone: {
    display: '953 50 14 51',
    value: '953501451',
    note: 'Atención exclusiva por llamada telefónica',
  },
  email: 'lolaestetica@hotmail.com',
  // Horario estático de respaldo (por día, coincide con Google Maps)
  hours: [
    { days: 'Lunes',      time: '9:00–14:00, 16:30–20:00' },
    { days: 'Martes',     time: '9:30–13:30, 17:00–21:00' },
    { days: 'Miércoles',  time: '9:00–14:00, 17:00–20:00' },
    { days: 'Jueves',     time: '9:30–13:30, 17:00–21:00' },
    { days: 'Viernes',    time: '9:30–13:30, 17:00–21:00' },
    { days: 'Sábado',     time: '9:30–14:00' },
    { days: 'Domingo',    time: 'Cerrado' },
  ],
};
---

<section class="bg-light section contacto" id="contacto">
  <div class="container">
    
    <!-- Section Header -->
    <div class="contacto__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Contacto</span>
      </div>
      <h2 class="contacto__title reveal reveal--up stagger-2">
        Estamos aquí para cuidarte
      </h2>
    </div>

    <div class="contacto__wrapper">
      
      <!-- Contact Cards Column -->
      <div class="contacto__cards">
        
        <!-- Address Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-2">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 21C16 16.8 19 13.1 19 9.5C19 5.36 15.86 2 12 2C8.14 2 5 5.36 5 9.5C5 13.1 8 16.8 12 21Z" />
              <circle cx="12" cy="9.5" r="3" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Ubicación</h3>
            <p>{contactInfo.address.street}</p>
            <p>{contactInfo.address.city}</p>
            <a
              href={contactInfo.address.gmapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="contacto__card-link"
            >
              Ver en Google Maps →
            </a>
          </div>
        </div>

        <!-- Phone Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-3">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Teléfono & Citas</h3>
            <p>{contactInfo.phone.display}</p>
            <p class="contacto__note">{contactInfo.phone.note}</p>
            <div class="contacto__card-actions">
              <a href={`tel:${contactInfo.phone.value}`} class="contacto__card-link text-accent">
                Llamar ahora →
              </a>
            </div>
          </div>
        </div>

        <!-- Hours Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-4">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <div class="contacto__hours-header">
              <h3>Horario</h3>
              <span id="gmaps-status" class="hours-status" style="display:none" aria-live="polite"></span>
            </div>
            <!-- Dynamic hours container (populated by JS if API is configured) -->
            <div id="gmaps-hours">
              {contactInfo.hours.map((schedule) => (
                <div class="contacto__hours-row">
                  <span class="contacto__hours-days">{schedule.days}:</span>
                  <span class="contacto__hours-time">{schedule.time}</span>
                </div>
              ))}
            </div>
            <p id="gmaps-source" class="contacto__note" style="display:none">Horario actualizado desde Google Business</p>
          </div>
        </div>

        <!-- Email Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-5">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Correo Electrónico</h3>
            <p>{contactInfo.email}</p>
            <a href={`mailto:${contactInfo.email}`} class="contacto__card-link">
              Enviar un correo →
            </a>
          </div>
        </div>

      </div>

      <!-- Map & Direct CTA Column -->
      <div class="contacto__map-container reveal reveal--scale stagger-3">
        <div class="contacto__map-frame">
          <iframe
            title="Ubicación Centro De Estética Lola Muñoz"
            src="https://maps.google.com/maps?q=C.%20Juego%20Pelotas,%202,%2023740%20And%C3%BAjar,%20Ja%C3%A9n&t=&z=17&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="contacto__map-iframe"
          ></iframe>
        </div>

        <div class="contacto__whatsapp-cta">
          <div class="contacto__whatsapp-text">
            <h4>¿Quieres pedir cita o resolver tus dudas?</h4>
            <p>Atención directa y personalizada por llamada telefónica.</p>
          </div>
          <Button
            href={`tel:${contactInfo.phone.value}`}
            variant="primary"
            size="md"
          >
            Llamar al 953 50 14 51
          </Button>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Google Places API: Horarios en tiempo real desde Google Business Profile -->
<script define:vars={{ googleApiKey, googlePlaceId }}>
  async function loadGmapsHours() {
    // Skip if credentials not configured
    if (!googleApiKey || !googlePlaceId) return;

    const container = document.getElementById('gmaps-hours');
    const statusEl  = document.getElementById('gmaps-status');
    const sourceEl  = document.getElementById('gmaps-source');
    if (!container) return;

    try {
      // currentOpeningHours includes special hours for public holidays
      const fields = 'currentOpeningHours,regularOpeningHours';
      const url = `https://places.googleapis.com/v1/places/${googlePlaceId}` +
                  `?fields=${fields}&languageCode=es&key=${googleApiKey}`;

      const res = await fetch(url);
      if (!res.ok) throw new Error(`Places API error ${res.status}`);

      const data = await res.json();

      // Prefer currentOpeningHours (includes festivos) over regularOpeningHours
      const hours = data.currentOpeningHours ?? data.regularOpeningHours;
      if (!hours?.weekdayDescriptions?.length) throw new Error('No hours data');

      // --- Status badge: Abierto / Cerrado ---
      if (statusEl && hours.openNow !== undefined) {
        statusEl.textContent = hours.openNow ? '● Abierto ahora' : '● Cerrado ahora';
        statusEl.className   = `hours-status ${hours.openNow ? 'hours-status--open' : 'hours-status--closed'}`;
        statusEl.style.display = 'inline-block';
      }

      // --- Render days ---
      // weekdayDescriptions (es): ["lunes: 9:00–14:00, 16:30–20:00", "martes: ...", ...]
      // Google returns Mon(0)…Sun(6); reorder so Monday is first
      container.innerHTML = hours.weekdayDescriptions.map((desc) => {
        const colonIdx = desc.indexOf(':');
        const rawDay   = desc.slice(0, colonIdx).trim();
        const time     = desc.slice(colonIdx + 1).trim();
        const day      = rawDay.charAt(0).toUpperCase() + rawDay.slice(1);
        const isClosed = time.toLowerCase() === 'cerrado' || time.toLowerCase() === 'closed';

        return `<div class="contacto__hours-row">
          <span class="contacto__hours-days">${day}:</span>
          <span class="contacto__hours-time${isClosed ? ' hours-closed' : ''}">${time}</span>
        </div>`;
      }).join('');

      // Show "updated from Google" note
      if (sourceEl) sourceEl.style.display = 'block';

    } catch (err) {
      // Silent fail — static hours remain visible
      console.warn('[Horario GMaps]', err.message);
    }
  }

  document.addEventListener('DOMContentLoaded', loadGmapsHours);
  document.addEventListener('astro:page-load', loadGmapsHours);
</script>

<style>
  .contacto {
    background-color: var(--color-bg);
    position: relative;
  }

  .contacto__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .contacto__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  /* Grid Layout */
  .contacto__wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 992px) {
    .contacto__wrapper {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Contact Cards Grid */
  .contacto__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 576px) and (max-width: 991px) {
    .contacto__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contacto__card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .contacto__card-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-elevated, #1E1E1E);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  .contacto__card-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contacto__card-content h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .contacto__card-content p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contacto__note {
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin-top: 0.15rem;
  }

  .contacto__card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: var(--text-xs);
  }

  .contacto__card-link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    margin-top: 0.4rem;
    display: inline-block;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .contacto__card-link:hover {
    color: var(--color-accent);
  }

  .contacto__separator {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .contacto__hours-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  /* "Abierto" / "Cerrado" badge */
  .hours-status {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .hours-status--open {
    background-color: rgba(74, 222, 128, 0.12);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
  }

  .hours-status--closed {
    background-color: rgba(248, 113, 113, 0.12);
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.3);
  }

  .hours-closed {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .contacto__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: var(--text-xs);
  }

  .contacto__hours-days {
    color: var(--color-text-muted);
  }

  .contacto__hours-time {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* Map Container */
  .contacto__map-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .contacto__map-frame {
    width: 100%;
    min-height: 320px;
    height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    background-color: var(--color-bg-alt);
  }

  .contacto__map-iframe {
    width: 100%;
    height: 100%;
    min-height: 320px;
    filter: grayscale(0.6) contrast(0.85) brightness(0.8);
  }

  .contacto__whatsapp-cta {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  @media (min-width: 576px) {
    .contacto__whatsapp-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .contacto__whatsapp-text h4 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .contacto__whatsapp-text p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }
</style>
