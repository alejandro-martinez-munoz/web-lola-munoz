---
/**
 * ContactoSection — Dark Luxe Contact Section.
 *
 * Features:
 *   - Simplified header text
 *   - Dark contact cards with golden accents
 *   - Map & WhatsApp CTA
 */
import Button from './Button.astro';

const contactInfo = {
  address: {
    street: 'Calle de la Belleza, 12, Local A',
    city: '28001 Madrid',
    gmapsUrl: 'https://maps.google.com/?q=Madrid',
  },
  phone: {
    display: '+34 612 345 678',
    value: '+34612345678',
    whatsappUrl: 'https://wa.me/34612345678?text=Hola%20Lola,%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20sobre%20los%20tratamientos.',
  },
  email: 'info@centrodeesteticalolamunoz.com',
  hours: [
    { days: 'Lunes a Viernes', time: '10:00 - 20:00 h' },
    { days: 'Sábados', time: '10:00 - 14:00 h (Cita previa)' },
    { days: 'Domingos', time: 'Cerrado' },
  ],
};
---

<section class="bg-light section contacto" id="contacto">
  <div class="container">
    
    <!-- Section Header -->
    <div class="contacto__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Contacto</span>
      </div>
      <h2 class="contacto__title reveal reveal--up stagger-2">
        Estamos aquí para cuidarte
      </h2>
    </div>

    <div class="contacto__wrapper">
      
      <!-- Contact Cards Column -->
      <div class="contacto__cards">
        
        <!-- Address Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-2">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 21C16 16.8 19 13.1 19 9.5C19 5.36 15.86 2 12 2C8.14 2 5 5.36 5 9.5C5 13.1 8 16.8 12 21Z" />
              <circle cx="12" cy="9.5" r="3" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Ubicación</h3>
            <p>{contactInfo.address.street}</p>
            <p>{contactInfo.address.city}</p>
            <a
              href={contactInfo.address.gmapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="contacto__card-link"
            >
              Ver en Google Maps →
            </a>
          </div>
        </div>

        <!-- Phone & WhatsApp Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-3">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Teléfono & WhatsApp</h3>
            <p>{contactInfo.phone.display}</p>
            <div class="contacto__card-actions">
              <a href={`tel:${contactInfo.phone.value}`} class="contacto__card-link">
                Llamar ahora
              </a>
              <span class="contacto__separator">•</span>
              <a
                href={contactInfo.phone.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="contacto__card-link text-accent"
              >
                WhatsApp →
              </a>
            </div>
          </div>
        </div>

        <!-- Hours Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-4">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Horario</h3>
            {contactInfo.hours.map((schedule) => (
              <div class="contacto__hours-row">
                <span class="contacto__hours-days">{schedule.days}:</span>
                <span class="contacto__hours-time">{schedule.time}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Email Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-5">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Correo Electrónico</h3>
            <p>{contactInfo.email}</p>
            <a href={`mailto:${contactInfo.email}`} class="contacto__card-link">
              Enviar un correo →
            </a>
          </div>
        </div>

      </div>

      <!-- Map & Direct CTA Column -->
      <div class="contacto__map-container reveal reveal--scale stagger-3">
        <div class="contacto__map-frame">
          <iframe
            title="Ubicación Centro De Estética Lola Muñoz"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12148.918234509123!2d-3.7037902!3d40.4167754!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd42287d12345678%3A0x123456789abcdef!2sMadrid!5e0!3m2!1ses!2ses!4v1600000000000!5m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="contacto__map-iframe"
          ></iframe>
        </div>

        <div class="contacto__whatsapp-cta">
          <div class="contacto__whatsapp-text">
            <h4>¿Prefieres WhatsApp?</h4>
            <p>Respuesta rápida para consultas o citas.</p>
          </div>
          <Button
            href={contactInfo.phone.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="md"
          >
            Abrir WhatsApp
          </Button>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .contacto {
    background-color: var(--color-bg);
    position: relative;
  }

  .contacto__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .contacto__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  /* Grid Layout */
  .contacto__wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 992px) {
    .contacto__wrapper {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Contact Cards Grid */
  .contacto__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 576px) and (max-width: 991px) {
    .contacto__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contacto__card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .contacto__card-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-elevated, #1E1E1E);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  .contacto__card-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contacto__card-content h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .contacto__card-content p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contacto__card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: var(--text-xs);
  }

  .contacto__card-link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    margin-top: 0.4rem;
    display: inline-block;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .contacto__card-link:hover {
    color: var(--color-accent);
  }

  .contacto__separator {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .contacto__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: var(--text-xs);
  }

  .contacto__hours-days {
    color: var(--color-text-muted);
  }

  .contacto__hours-time {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* Map Container */
  .contacto__map-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .contacto__map-frame {
    width: 100%;
    min-height: 320px;
    height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    background-color: var(--color-bg-alt);
  }

  .contacto__map-iframe {
    width: 100%;
    height: 100%;
    min-height: 320px;
    filter: grayscale(0.6) contrast(0.85) brightness(0.8);
  }

  .contacto__whatsapp-cta {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  @media (min-width: 576px) {
    .contacto__whatsapp-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .contacto__whatsapp-text h4 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .contacto__whatsapp-text p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }
</style>
