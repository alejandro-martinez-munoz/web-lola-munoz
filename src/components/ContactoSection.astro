---
/**
 * ContactoSection — Dark Luxe Contact Section.
 *
 * Features:
 *   - Simplified header text
 *   - Dark contact cards with golden accents
 *   - Live hours from Google Places API (falls back to static if API not configured)
 *   - Map & call CTA
 */
import Button from './Button.astro';

// Google Places API config (set in .env)
const googleApiKey = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY ?? '';
const googlePlaceId = import.meta.env.PUBLIC_GOOGLE_PLACE_ID ?? '';

const contactInfo = {
  address: {
    street: 'C. Juego Pelotas, n°2, 1° Derecha',
    city: '23740 Andújar, Jaén',
    gmapsUrl: 'https://maps.google.com/?q=C.+Juego+Pelotas,+2,+23740+And%C3%BAjar,+Ja%C3%A9n',
  },
  phone: {
    display: '953 50 14 51',
    value: '953501451',
    note: 'Atención exclusiva por llamada telefónica',
  },
  email: 'lolaestetica@hotmail.com',
  // Horario estático de respaldo con separador claro entre turnos
  hours: [
    { days: 'Lunes',      time: '9:00–14:00 / 16:30–20:00' },
    { days: 'Martes',     time: '9:30–13:30 / 17:00–21:00' },
    { days: 'Miércoles',  time: '9:00–14:00 / 17:00–20:00' },
    { days: 'Jueves',     time: '9:30–13:30 / 17:00–21:00' },
    { days: 'Viernes',    time: '9:30–13:30 / 17:00–21:00' },
    { days: 'Sábado',     time: '9:30–14:00' },
    { days: 'Domingo',    time: 'Cerrado' },
  ],
};
---

<section class="bg-light section contacto" id="contacto">
  <div class="container">
    
    <!-- Section Header -->
    <div class="contacto__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Contacto</span>
      </div>
      <h2 class="contacto__title reveal reveal--up stagger-2">
        Estamos aquí para cuidarte
      </h2>
    </div>

    <div class="contacto__wrapper">
      
      <!-- Contact Cards Column -->
      <div class="contacto__cards">
        
        <!-- Address Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-2">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 21C16 16.8 19 13.1 19 9.5C19 5.36 15.86 2 12 2C8.14 2 5 5.36 5 9.5C5 13.1 8 16.8 12 21Z" />
              <circle cx="12" cy="9.5" r="3" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Ubicación</h3>
            <p>{contactInfo.address.street}</p>
            <p>{contactInfo.address.city}</p>
            <a
              href={contactInfo.address.gmapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="contacto__card-link"
            >
              Ver en Google Maps →
            </a>
          </div>
        </div>

        <!-- Hours Card -->
        <div class="contacto__card contacto__card--hours hover-lift reveal reveal--up stagger-3">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <div class="contacto__hours-header">
              <h3>Horario de atención</h3>
            </div>
            <div id="gmaps-hours" class="contacto__hours-list">
              {contactInfo.hours.map((schedule) => {
                const isClosed = schedule.time.toLowerCase().includes('cerrado');
                return (
                  <div class="contacto__hours-row">
                    <span class="contacto__hours-days">{schedule.days}</span>
                    <span class="contacto__hours-line"></span>
                    <span class={`contacto__hours-time ${isClosed ? 'contacto__hours-closed' : ''}`}>
                      {schedule.time}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        <!-- Email Card -->
        <div class="contacto__card hover-lift reveal reveal--up stagger-4">
          <div class="contacto__card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </div>
          <div class="contacto__card-content">
            <h3>Correo Electrónico</h3>
            <p>{contactInfo.email}</p>
            <a href={`mailto:${contactInfo.email}`} class="contacto__card-link">
              Enviar un correo →
            </a>
          </div>
        </div>

      </div>

      <!-- Map & Direct CTA Column -->
      <div class="contacto__map-container reveal reveal--scale stagger-3">
        <div class="contacto__map-frame">
          <iframe
            title="Ubicación Centro De Estética Lola Muñoz"
            src="https://maps.google.com/maps?q=C.%20Juego%20Pelotas,%202,%2023740%20And%C3%BAjar,%20Ja%C3%A9n&t=&z=17&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="contacto__map-iframe"
          ></iframe>
        </div>

        <div class="contacto__whatsapp-cta">
          <div class="contacto__whatsapp-text">
            <h4>¿Con dudas?</h4>
            <p>Atención directa por llamada telefónica.</p>
          </div>
          <Button
            href={`tel:${contactInfo.phone.value}`}
            variant="primary"
            size="md"
          >
            Llamar al 953 50 14 51
          </Button>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Google Places API: Horarios en tiempo real desde Google Business Profile -->
<script define:vars={{ googleApiKey, googlePlaceId }}>
  async function loadGmapsHours() {
    // Skip if credentials not configured
    if (!googleApiKey || !googlePlaceId) return;

    const container = document.getElementById('gmaps-hours');
    if (!container) return;

    try {
      // currentOpeningHours includes special hours for public holidays
      const fields = 'currentOpeningHours,regularOpeningHours';
      const url = `https://places.googleapis.com/v1/places/${googlePlaceId}` +
                  `?fields=${fields}&languageCode=es&key=${googleApiKey}`;

      const res = await fetch(url);
      if (!res.ok) throw new Error(`Places API error ${res.status}`);

      const data = await res.json();

      // Prefer currentOpeningHours (includes festivos) over regularOpeningHours
      const hours = data.currentOpeningHours ?? data.regularOpeningHours;
      if (!hours?.weekdayDescriptions?.length) throw new Error('No hours data');

      container.innerHTML = hours.weekdayDescriptions.map((desc) => {
        const colonIdx = desc.indexOf(':');
        const rawDay   = desc.slice(0, colonIdx).trim();
        const timeStr  = desc.slice(colonIdx + 1).trim().replace(/,\s*/g, ' / ');
        const day      = rawDay.charAt(0).toUpperCase() + rawDay.slice(1);
        const isClosed = timeStr.toLowerCase().includes('cerrado') || timeStr.toLowerCase().includes('closed');

        return `<div class="contacto__hours-row">
          <span class="contacto__hours-days">${day}</span>
          <span class="contacto__hours-line"></span>
          <span class="contacto__hours-time ${isClosed ? 'contacto__hours-closed' : ''}">${isClosed ? 'Cerrado' : timeStr}</span>
        </div>`;
      }).join('');

    } catch (err) {
      // Silent fail — static hours remain visible
      console.warn('[Horario GMaps]', err.message);
    }
  }

  document.addEventListener('DOMContentLoaded', loadGmapsHours);
  document.addEventListener('astro:page-load', loadGmapsHours);
</script>

<style>
  .contacto {
    background-color: var(--color-bg);
    position: relative;
  }

  .contacto__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: clamp(2.5rem, 4vw, 4.5rem);
  }

  .contacto__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  /* Grid Layout */
  .contacto__wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 992px) {
    .contacto__wrapper {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Contact Cards Grid */
  .contacto__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 576px) and (max-width: 991px) {
    .contacto__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contacto__card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .contacto__card-icon {
    width: 2.85rem;
    height: 2.85rem;
    border-radius: 12px;
    background-color: #FFFFFF;
    color: #836733;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(131, 103, 51, 0.25);
    box-shadow: 0 2px 8px rgba(44, 36, 30, 0.05);
  }

  .contacto__card-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contacto__card-content h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .contacto__card-content p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contacto__note {
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin-top: 0.15rem;
  }

  .contacto__card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: var(--text-xs);
  }

  .contacto__card-link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    margin-top: 0.4rem;
    display: inline-block;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .contacto__card-link:hover {
    color: var(--color-accent);
  }

  .contacto__separator {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .contacto__hours-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  :global(.contacto__hours-list) {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 0.6rem;
    width: 100%;
  }

  :global(.contacto__hours-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  :global(.contacto__hours-days) {
    font-family: var(--font-sans) !important;
    font-size: 1rem !important; /* 16px */
    font-weight: 700 !important;
    color: #836733 !important;
    white-space: nowrap !important;
    min-width: 6.2rem !important;
  }

  :global(.contacto__hours-line) {
    flex: 1;
    height: 1px;
    border-bottom: 1px dashed rgba(131, 103, 51, 0.25) !important;
    margin-inline: 0.5rem !important;
  }

  :global(.contacto__hours-time) {
    font-family: var(--font-sans) !important;
    color: #2C241E !important;
    font-weight: 600 !important;
    font-size: 1.0625rem !important; /* 17px - large, crisp & readable */
    white-space: nowrap !important;
    text-align: right !important;
    letter-spacing: 0.01em !important;
  }

  :global(.contacto__hours-closed) {
    color: #8C7C72 !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: 1rem !important;
  }

  /* Map Container */
  .contacto__map-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .contacto__map-frame {
    width: 100%;
    min-height: 320px;
    height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    background-color: var(--color-bg-alt);
  }

  .contacto__map-iframe {
    width: 100%;
    height: 100%;
    min-height: 320px;
    filter: grayscale(0.6) contrast(0.85) brightness(0.8);
  }

  .contacto__whatsapp-cta {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  @media (min-width: 576px) {
    .contacto__whatsapp-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .contacto__whatsapp-text h4 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .contacto__whatsapp-text p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }
</style>
