---
/**
 * CookieBanner — LSSI-CE compliant cookie notice.
 *
 * Shows on first visit, stores consent in localStorage.
 * Minimal technical cookies only (no tracking).
 */
---

<div id="cookie-banner" class="cookie-banner" aria-live="polite" role="region" aria-label="Aviso de cookies">
  <div class="cookie-banner__container">
    <div class="cookie-banner__content">
      <h3 class="cookie-banner__title">Política de Cookies</h3>
      <p class="cookie-banner__text">
        Este sitio web utiliza cookies técnicas estrictamente necesarias para su correcto funcionamiento.
        Al continuar navegando, aceptas su uso. Puedes consultar más información en nuestra
        <a href="/politica-de-cookies" class="cookie-banner__link">Política de Cookies</a>.
      </p>
    </div>
    <div class="cookie-banner__actions">
      <button
        id="cookie-accept"
        class="cookie-banner__button cookie-banner__button--primary"
        aria-label="Aceptar cookies"
      >
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');

    if (!banner || !acceptBtn) return;

    // Check if user already consented
    const cookieConsent = localStorage.getItem('cookie-consent');

    if (cookieConsent === 'accepted') {
      banner.style.display = 'none';
      return;
    }

    // Show banner after a short delay
    setTimeout(() => {
      banner.classList.add('cookie-banner--visible');
    }, 1000);

    // Handle accept button
    acceptBtn.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'accepted');
      banner.classList.remove('cookie-banner--visible');

      // Remove from DOM after animation
      setTimeout(() => {
        banner.style.display = 'none';
      }, 300);
    });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner);
  } else {
    initCookieBanner();
  }

  // Re-run on Astro view transitions
  document.addEventListener('astro:page-load', initCookieBanner);
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 20px rgba(44, 36, 30, 0.08);
    padding: var(--space-md) var(--space-lg);
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-out);
  }

  .cookie-banner--visible {
    transform: translateY(0);
  }

  .cookie-banner__container {
    max-width: 1240px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cookie-banner__container {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cookie-banner__content {
    flex: 1;
  }

  .cookie-banner__title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .cookie-banner__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .cookie-banner__link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cookie-banner__link:hover {
    color: var(--color-accent-hover);
  }

  .cookie-banner__actions {
    display: flex;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .cookie-banner__button {
    padding: 0.625rem 1.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    border: none;
    white-space: nowrap;
  }

  .cookie-banner__button--primary {
    background-color: var(--color-accent);
    color: #FFF;
    border: 1px solid var(--color-accent);
  }

  .cookie-banner__button--primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(150, 123, 69, 0.25);
  }

  .cookie-banner__button--primary:active {
    transform: translateY(0);
  }

  .cookie-banner__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
