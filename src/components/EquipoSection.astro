---
/**
 * EquipoSection — Dark Luxe Team Showcase.
 *
 * Features:
 *   - Real photos for team members
 *   - Dark cards with golden accents
 *   - Subtle founder badge
 *   - Image hover zoom effect
 */

interface TeamMember {
  id: string;
  name: string;
  role: string;
  imageSrc: string;
  isFounder?: boolean;
}

const team: TeamMember[] = [
  {
    id: 'lola',
    name: 'Lola Muñoz',
    role: 'Estética Avanzada',
    imageSrc: '/images/equipo/lola.png',
    isFounder: true,
  },
  {
    id: 'paloma',
    name: 'Paloma',
    role: 'Estética Facial & Aparatología',
    imageSrc: '/images/equipo/paloma.png',
  },
  {
    id: 'vero',
    name: 'Vero',
    role: 'Estética Corporal & Mirada',
    imageSrc: '/images/equipo/vero.png',
  },
  {
    id: 'loli',
    name: 'Loli',
    role: 'Manicura, Pedicura & Relax',
    imageSrc: '/images/equipo/loli.png',
  },
];
---

<section class="bg-dark section equipo" id="equipo">
  <div class="container">
    
    <!-- Section Header -->
    <div class="equipo__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Manos Expertas</span>
      </div>
      <h2 class="equipo__title reveal reveal--up stagger-2">
        Nuestro equipo
      </h2>
    </div>

    <!-- Team Grid (4 Members) -->
    <div class="equipo__grid">
      {team.map((member, index) => (
        <article class={`team-card ${member.isFounder ? 'team-card--founder' : ''} hover-lift reveal reveal--up stagger-${index + 1}`}>
          

          <!-- Photo Container -->
          <div class="team-card__image-wrap">
            <img
              src={member.imageSrc}
              alt={`Fotografía de ${member.name}`}
              class="team-card__img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Condensed Info -->
          <div class="team-card__content">
            <h3 class="team-card__name">{member.name}</h3>
            <span class="team-card__role">{member.role}</span>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .equipo {
    background-color: var(--color-bg);
    position: relative;
  }

  .equipo__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-lg);
  }

  .equipo__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  /* Grid Layout (4 columns on desktop, 2 on tablet/mobile) */
  .equipo__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    padding-top: 1.75rem; /* Room for floating eyebrow header */
  }

  @media (min-width: 1024px) {
    .equipo__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Team Card — Dark Luxe */
  .team-card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    position: relative;
    display: flex;
    flex-direction: column;
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .team-card:hover {
    border-color: var(--color-accent);
  }

  /* Founder Card Highlight */
  .team-card--founder {
    border-color: rgba(197, 160, 89, 0.45);
    box-shadow: 0 8px 30px rgba(131, 103, 51, 0.14), 0 0 16px rgba(197, 160, 89, 0.12);
  }

  .team-card--founder:hover {
    border-color: #D4B87B;
    box-shadow: 0 12px 36px rgba(131, 103, 51, 0.22), 0 0 20px rgba(212, 184, 123, 0.25);
  }

  .team-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: calc(var(--radius-xl) - 1px) calc(var(--radius-xl) - 1px) 0 0;
    background-color: var(--color-bg-elevated, #1E1E1E);
  }

  .team-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .team-card:hover .team-card__img {
    transform: scale(1.04);
  }

  .team-card__founder-label {
    position: absolute;
    top: -1.65rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFFFFF;
    pointer-events: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .team-card__content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
  }

  .team-card__name {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
    line-height: 1.2;
    margin: 0;
  }

  .team-card__role {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }
</style>
