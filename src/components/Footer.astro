---
/**
 * Footer — High Contrast Footer.
 */
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Inicio', href: '#hero' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Equipo', href: '#equipo' },
  { label: 'Contacto', href: '#contacto' },
];

const treatments = [
  { label: 'Faciales Avanzados', href: '#servicios' },
  { label: 'Estética Corporal', href: '#servicios' },
  { label: 'Manicura & Pedicura', href: '#servicios' },
  { label: 'Masajes & Bienestar', href: '#servicios' },
];

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/centrodeesteticalolamunoz/',
    iconSvg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/centroesteticalola/?locale=es_ES',
    iconSvg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
];
---

<footer class="bg-dark footer">
  <div class="container">
    
    <!-- Shimmer line at top -->
    <div class="shimmer-line" style="margin-bottom: var(--space-2xl); opacity: 0.6;"></div>

    <!-- Top Footer Grid -->
    <div class="footer__top">
      
      <!-- Brand Info Column -->
      <div class="footer__brand">
        <a href="#hero" class="footer__logo">
          <span class="footer__logo-title">Lola Muñoz</span>
          <span class="footer__logo-subtitle">CENTRO DE ESTÉTICA</span>
        </a>
        <p class="footer__tagline">
          Tu espacio de belleza, calma y tratamientos personalizados
        </p>
        <div class="footer__socials">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social-link"
              aria-label={social.name}
            >
              <Fragment set:html={social.iconSvg} />
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Nav Column -->
      <div class="footer__col">
        <h4 class="footer__col-title">Navegación</h4>
        <ul class="footer__links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer__link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Treatments Column -->
      <div class="footer__col">
        <h4 class="footer__col-title">Tratamientos</h4>
        <ul class="footer__links">
          {treatments.map((item) => (
            <li>
              <a href={item.href} class="footer__link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info Column -->
      <div class="footer__col">
        <h4 class="footer__col-title">Atención</h4>
        <ul class="footer__info">
          <li>C. Juego Pelotas, n°2, 1° Derecha</li>
          <li>23740 Andújar, Jaén</li>
          <li class="footer__info-accent">
            <a href="tel:953501451" style="color: inherit; text-decoration: none;">953 50 14 51</a>
          </li>
          <li>lolaestetica@hotmail.com</li>
        </ul>
      </div>

    </div>

    <!-- Divider & Bottom Sub-Footer -->
    <div class="footer__bottom">
      <p class="footer__copyright">
        © {currentYear} Centro De Estética Lola Muñoz. Todos los derechos reservados.
      </p>

      <div class="footer__legal">
        <a href="/aviso-legal" class="footer__legal-link">Aviso Legal</a>
        <span class="footer__legal-sep">•</span>
        <a href="/politica-de-privacidad" class="footer__legal-link">Política de Privacidad</a>
        <span class="footer__legal-sep">•</span>
        <a href="/politica-de-cookies" class="footer__legal-link">Cookies</a>
      </div>

      <!-- Scroll to Top Button -->
      <a href="#hero" class="footer__scroll-top" aria-label="Volver arriba">
        <span>Arriba</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 13V3M8 3L3 8M8 3L13 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</footer>

<style>
  .footer {
    background-color: #2C241E;
    color: #F9F6F0;
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-top: 1px solid rgba(245, 240, 232, 0.12);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid rgba(245, 240, 232, 0.12);
  }

  @media (min-width: 640px) {
    .footer__top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer__top {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .footer__logo-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    color: #F9F6F0;
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__logo-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    color: #D4B87B;
  }

  .footer__logo:hover .footer__logo-title {
    color: #D4B87B;
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: #D3C9BC;
    line-height: 1.6;
    max-width: 32ch;
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: 0.5rem;
  }

  .footer__social-link {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: rgba(245, 240, 232, 0.08);
    color: #F9F6F0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 1px solid rgba(245, 240, 232, 0.25);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    background-color: #D4B87B;
    color: #2C241E;
    border-color: #D4B87B;
    transform: translateY(-3px);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__col-title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: #D4B87B; /* Warm high-contrast gold for column headers */
  }

  .footer__links,
  .footer__info {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__link {
    font-size: var(--text-sm);
    color: #E2DBCF; /* Crisp readable light text */
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__link:hover {
    color: #D4B87B;
  }

  .footer__info li {
    font-size: var(--text-sm);
    color: #E2DBCF;
    line-height: 1.5;
  }

  .footer__info-accent {
    color: #F9F6F0 !important;
    font-weight: var(--weight-semibold);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-xl);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: #B8B0A5;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-xs);
  }

  .footer__legal-link {
    color: #B8B0A5;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__legal-link:hover {
    color: #D4B87B;
  }

  .footer__legal-sep {
    color: rgba(245, 240, 232, 0.2);
  }

  .footer__scroll-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #E2DBCF;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .footer__scroll-top:hover {
    color: #D4B87B;
    transform: translateY(-2px);
  }
</style>
