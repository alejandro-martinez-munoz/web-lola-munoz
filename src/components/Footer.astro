---
/**
 * Footer Component — Minimalist dark footer with high-end aesthetic.
 *
 * Features:
 *   - Brand identity & tagline
 *   - Navigation links & treatment highlights
 *   - Social media icons & direct contact shortcuts
 *   - Interactive "Back to top" button
 *   - Copyright & legal links
 */
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Inicio', href: '#hero' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Sobre Mí', href: '#sobre-mi' },
  { label: 'Contacto', href: '#contacto' },
];

const treatments = [
  { label: 'Faciales Avanzados', href: '#servicios' },
  { label: 'Estética Corporal', href: '#servicios' },
  { label: 'Diagnóstico Cutáneo', href: '#servicios' },
  { label: 'Maderoterapia & Masajes', href: '#servicios' },
];

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://instagram.com',
    iconSvg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    name: 'WhatsApp',
    href: 'https://wa.me/34612345678',
    iconSvg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
  {
    name: 'Facebook',
    href: 'https://facebook.com',
    iconSvg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
];
---

<footer class="footer">
  <div class="container">
    
    <!-- Top Footer Grid -->
    <div class="footer__top">
      
      <!-- Brand Info Column -->
      <div class="footer__brand">
        <a href="#hero" class="footer__logo">
          <span class="footer__logo-title">Lola Muñoz</span>
          <span class="footer__logo-subtitle">CENTRO DE ESTÉTICA</span>
        </a>
        <p class="footer__tagline">
          Tu espacio de relajación, belleza natural y salud para tu piel.
          Atención cercana y profesional en cada tratamiento.
        </p>
        <div class="footer__socials">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social-link"
              aria-label={social.name}
            >
              <Fragment set:html={social.iconSvg} />
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Nav Column -->
      <div class="footer__col">
        <h4 class="footer__col-title">Navegación</h4>
        <ul class="footer__links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer__link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Treatments Column -->
      <div class="footer__col">
        <h4 class="footer__col-title">Tratamientos</h4>
        <ul class="footer__links">
          {treatments.map((item) => (
            <li>
              <a href={item.href} class="footer__link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info Column -->
      <div class="footer__col">
        <h4 class="footer__col-title">Atención</h4>
        <ul class="footer__info">
          <li>Calle de la Belleza, 12, Local A</li>
          <li>28001 Madrid</li>
          <li class="footer__info-accent">+34 612 345 678</li>
          <li>info@centrodeesteticalolamunoz.com</li>
        </ul>
      </div>

    </div>

    <!-- Divider & Bottom Sub-Footer -->
    <div class="footer__bottom">
      <p class="footer__copyright">
        © {currentYear} Centro De Estética Lola Muñoz. Todos los derechos reservados.
      </p>

      <div class="footer__legal">
        <a href="#hero" class="footer__legal-link">Aviso Legal</a>
        <span class="footer__legal-sep">•</span>
        <a href="#hero" class="footer__legal-link">Política de Privacidad</a>
        <span class="footer__legal-sep">•</span>
        <a href="#hero" class="footer__legal-link">Política de Cookies</a>
      </div>

      <!-- Scroll to Top Button -->
      <a href="#hero" class="footer__scroll-top" aria-label="Volver arriba">
        <span>Arriba</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M8 13V3M8 3L3 8M8 3L13 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-dark);
    color: var(--color-text-light);
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-lg);
    border-top: 1px solid var(--color-bg-dark-alt);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-bg-dark-alt);
  }

  @media (min-width: 640px) {
    .footer__top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer__top {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    }
  }

  /* Brand Column */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .footer__logo-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text-light);
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__logo-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
  }

  .footer__logo:hover .footer__logo-title {
    color: var(--color-accent);
  }

  .footer__tagline {
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
    line-height: 1.6;
    max-width: 32ch;
  }

  /* Social Icons */
  .footer__socials {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: 0.25rem;
  }

  .footer__social-link {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: var(--color-bg-dark-alt);
    color: var(--color-text-light-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    background-color: var(--color-accent);
    color: var(--color-bg-dark);
    transform: translateY(-2px);
  }

  /* Footer Columns */
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer__col-title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .footer__links,
  .footer__info {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__link {
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--color-text-light);
  }

  .footer__info li {
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
    line-height: 1.5;
  }

  .footer__info-accent {
    color: var(--color-text-light) !important;
    font-weight: var(--weight-medium);
  }

  /* Bottom Footer */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
  }

  .footer__legal-link {
    color: var(--color-text-light-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__legal-link:hover {
    color: var(--color-accent);
  }

  .footer__legal-sep {
    color: var(--color-bg-dark-alt);
  }

  /* Scroll Top */
  .footer__scroll-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-light-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .footer__scroll-top:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }
</style>
