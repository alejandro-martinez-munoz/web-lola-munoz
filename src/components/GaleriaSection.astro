---
/**
 * GaleriaSection — Dark Luxe Gallery with Stock Images.
 *
 * Features:
 *   - Real stock images instead of SVG placeholders
 *   - Bento grid layout
 *   - Hover zoom with dark overlay captions
 *   - Simplified subtitle
 *   - Removed video tour mockup (no real video)
 */

interface GalleryItem {
  id: string;
  title: string;
  category: string;
  imageSrc: string;
  isLarge?: boolean;
}

const galleryItems: GalleryItem[] = [
  {
    id: 'recepcion',
    title: 'Recepción & Bienvenida',
    category: 'Entrada Principal',
    imageSrc: '/images/gallery-recepcion.png',
    isLarge: true,
  },
  {
    id: 'cabina-facial',
    title: 'Cabina de Tratamiento Facial',
    category: 'Cabina Privada',
    imageSrc: '/images/gallery-cabina-facial.png',
  },
  {
    id: 'zona-unas',
    title: 'Zona de Manicura & Pedicura',
    category: 'Espacio Manicura',
    imageSrc: '/images/gallery-zona-unas.png',
  },
  {
    id: 'cabina-masajes',
    title: 'Cabina de Masajes & Relax',
    category: 'Cabina Holística',
    imageSrc: '/images/gallery-masajes.png',
    isLarge: true,
  },
];
---

<section class="bg-light section galeria" id="instalaciones">
  <div class="container">
    
    <!-- Section Header -->
    <div class="galeria__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Instalaciones</span>
      </div>
      <h2 class="galeria__title reveal reveal--up stagger-2">
        Nuestro espacio
      </h2>
      <p class="galeria__subtitle reveal reveal--up stagger-3 text-balance">
        Cabinas privadas, higiene impecable y un ambiente pensado para tu confort.
      </p>
    </div>

    <!-- Gallery Bento Grid -->
    <div class="galeria__grid">
      {galleryItems.map((item, index) => (
        <div
          class={`galeria__card hover-lift reveal reveal--up stagger-${(index % 4) + 1} ${item.isLarge ? 'galeria__card--large' : ''}`}
        >
          <img
            src={item.imageSrc}
            alt={item.title}
            class="galeria__img"
            loading="lazy"
            decoding="async"
          />

          <!-- Overlay Caption -->
          <div class="galeria__overlay">
            <span class="galeria__category">{item.category}</span>
            <h3 class="galeria__item-title">{item.title}</h3>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .galeria {
    background-color: var(--color-bg-alt);
    position: relative;
  }

  .galeria__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .galeria__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .galeria__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 50ch;
    margin-top: var(--space-2xs);
  }

  /* Bento Grid */
  .galeria__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .galeria__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .galeria__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .galeria__card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-bg-elevated, #1E1E1E);
    border: 1px solid var(--color-border);
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .galeria__card:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 1024px) {
    .galeria__card--large {
      grid-column: span 2;
    }
  }

  .galeria__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .galeria__card:hover .galeria__img {
    transform: scale(1.05);
  }

  /* Overlay */
  .galeria__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-md) var(--space-lg);
    background: linear-gradient(to top, rgba(10, 10, 10, 0.9) 0%, rgba(10, 10, 10, 0) 100%);
    color: var(--color-text-light);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .galeria__card:hover .galeria__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .galeria__category {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .galeria__item-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    color: var(--color-text-light);
    margin: 0;
  }
</style>
