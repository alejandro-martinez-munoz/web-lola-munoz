---
/**
 * Hero Component — Central Flanked Experience Credential Accent.
 */
import Button from './Button.astro';
---

<section class="bg-dark hero" id="hero">
  <!-- Background Image -->
  <div class="hero__bg">
    <img
      src="/images/hero-spa.png"
      alt="Interior del Centro de Estética Lola Muñoz"
      class="hero__bg-img"
      loading="eager"
      decoding="async"
    />
    <div class="hero__bg-overlay"></div>
  </div>

  <div class="container hero__container">
    
    <!-- Main Content Stack -->
    <div class="hero__content">
      <div class="reveal reveal--up stagger-1">
        <span class="label hero__eyebrow">Centro De Estética Avanzada</span>
      </div>

      <h1 class="hero__title reveal reveal--up stagger-2">
        Tu espacio de <span class="text-serif-italic">belleza</span> y calma
      </h1>

      <p class="hero__description reveal reveal--up stagger-3">
        Tratamientos faciales y corporales personalizados a tu medida
      </p>

      <!-- CENTRAL FLANKED ELEGANT CREDENTIAL (NO BUTTON CONFUSION) -->
      <div class="hero__experience-accent reveal reveal--up stagger-4">
        <span class="hero__line hero__line--left"></span>
        <div class="hero__experience-group">
          <span class="hero__exp-num">40+</span>
          <span class="hero__exp-label">Años de experiencia</span>
        </div>
        <span class="hero__line hero__line--right"></span>
      </div>

      <div class="hero__actions reveal reveal--up stagger-5">
        <Button href="#servicios" variant="primary" size="lg">
          Ver Tratamientos
        </Button>
        <Button href="#contacto" variant="secondary" size="lg">
          Contactar
        </Button>
      </div>
    </div>

  </div>

  <!-- Scroll Down Indicator -->
  <a href="#servicios" class="hero__scroll-indicator reveal reveal--fade stagger-6" aria-label="Ir a servicios">
    <span class="hero__scroll-text">Explorar</span>
    <svg class="hero__scroll-icon" width="18" height="18" viewBox="0 0 16 16" fill="none">
      <path d="M8 3V13M8 13L13 8M8 13L3 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: #2C241E;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(44, 36, 30, 0.45) 0%,
      rgba(44, 36, 30, 0.75) 50%,
      rgba(44, 36, 30, 0.94) 100%
    );
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: calc(6rem + var(--space-2xl));
    padding-bottom: var(--space-3xl);
    width: 100%;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 900px;
  }

  .hero__eyebrow {
    color: #D4B87B !important;
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
  }

  .hero__title {
    font-size: clamp(3.5rem, 5.5vw, 5.75rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #F9F6F0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    margin: 0;
  }

  .text-serif-italic {
    font-style: italic;
    color: #D4B87B;
  }

  .hero__description {
    font-size: clamp(1.2rem, 1.35vw, 1.5rem);
    line-height: 1.5;
    color: #E2DBCF;
    max-width: 52ch;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  /* CENTRAL ELEGANT FLANKED CREDENTIAL ACCENT */
  .hero__experience-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .hero__line {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #D4B87B, transparent);
  }

  .hero__line--left {
    background: linear-gradient(90deg, transparent 0%, #D4B87B 100%);
  }

  .hero__line--right {
    background: linear-gradient(90deg, #D4B87B 0%, transparent 100%);
  }

  .hero__experience-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__exp-num {
    font-family: var(--font-serif);
    font-size: 1.95rem;
    font-weight: 400;
    font-style: italic;
    color: #D4B87B;
    line-height: 1;
    transform: translateY(-4px);
  }

  .hero__exp-label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #F9F6F0;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: 0.5rem;
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: #E2DBCF;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero__scroll-text {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .hero__scroll-icon {
    animation: bounce 2s infinite ease-in-out;
  }

  .hero__scroll-indicator:hover {
    color: #D4B87B;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(6px); }
    60% { transform: translateY(3px); }
  }
</style>
