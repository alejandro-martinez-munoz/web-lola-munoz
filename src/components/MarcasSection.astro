---
/**
 * MarcasSection Component — Continuous Infinite Marquee Ticker with Smooth Mouse/Touch Drag.
 *
 * Features:
 *   - Continuous right-to-left auto-scroll engine (60fps requestAnimationFrame)
 *   - Interactive real-time Mouse & Touch Drag (grab/grabbing cursor)
 *   - Automatic seamless wrap-around and drag-and-resume
 *   - Zero font clipping on Germaine de Capuccini (expanded viewBox width to 460)
 */

interface BrandLogo {
  id: string;
  name: string;
  svgContent: string;
}

const brands: BrandLogo[] = [
  {
    id: 'natura-bisse',
    name: 'Natura Bissé',
    svgContent: `<svg width="300" height="80" viewBox="0 0 300 80" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="150" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="32" font-weight="600" letter-spacing="6" fill="#1A1A1A">NATURA BISSÉ</text><text x="150" y="64" text-anchor="middle" font-family="'Inter', sans-serif" font-size="11" letter-spacing="8" fill="#6B6B6B">BARCELONA</text></svg>`,
  },
  {
    id: 'germaine-de-capuccini',
    name: 'Germaine de Capuccini',
    svgContent: `<svg width="460" height="80" viewBox="0 0 460 80" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="230" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="26" font-weight="600" letter-spacing="4" fill="#1A1A1A">GERMAINE DE CAPUCCINI</text><text x="230" y="64" text-anchor="middle" font-family="'Inter', sans-serif" font-size="11" letter-spacing="7" fill="#6B6B6B">ALTA COSMÉTICA</text></svg>`,
  },
  {
    id: 'alan-coar',
    name: 'Alan Coar',
    svgContent: `<svg width="260" height="80" viewBox="0 0 260 80" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="130" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="34" font-weight="400" letter-spacing="7" fill="#1A1A1A">ALAN COAR</text><text x="130" y="64" text-anchor="middle" font-family="'Inter', sans-serif" font-size="10" letter-spacing="5" fill="#6B6B6B">SPECIALIST SKINCARE</text></svg>`,
  },
  {
    id: 'artdeco',
    name: 'Artdeco',
    svgContent: `<svg width="240" height="80" viewBox="0 0 240 80" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="120" y="44" text-anchor="middle" font-family="'Inter', sans-serif" font-size="32" font-weight="600" letter-spacing="8" fill="#1A1A1A">ARTDECO</text><text x="120" y="64" text-anchor="middle" font-family="'Inter', sans-serif" font-size="10" letter-spacing="7" fill="#6B6B6B">GERMANY</text></svg>`,
  },
  {
    id: 'mesoestetic',
    name: 'Mesoestetic',
    svgContent: `<svg width="300" height="80" viewBox="0 0 300 80" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="150" y="44" text-anchor="middle" font-family="'Inter', sans-serif" font-size="30" font-weight="500" letter-spacing="4" fill="#1A1A1A">mesoestetic®</text><text x="150" y="64" text-anchor="middle" font-family="'Inter', sans-serif" font-size="10" letter-spacing="6" fill="#6B6B6B">MEDICAL COSMETICS</text></svg>`,
  },
];

// Repeat brands 4 times for infinite loop
const repeatBrands = [...brands, ...brands, ...brands, ...brands];
---

<section class="marcas-ticker" id="firmas">
  <div class="marcas-ticker__viewport" id="ticker-viewport">
    <div class="marcas-ticker__track" id="ticker-track">
      {repeatBrands.map((brand) => (
        <div class="marcas-ticker__item" data-brand={brand.id}>
          <div class="marcas-ticker__logo" title={brand.name}>
            <Fragment set:html={brand.svgContent} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Optimized 60fps RequestAnimationFrame Ticker + Drag Script -->
<script>
  function initTickerEngine(): void {
    const viewport = document.getElementById('ticker-viewport');
    const track = document.getElementById('ticker-track');

    if (!viewport || !track) return;

    let offset = 0;
    const speed = 1.2; // Smooth right-to-left pixel movement per frame
    let isDragging = false;
    let startX = 0;
    let dragStartOffset = 0;
    let setWidth = 0;

    function measureSetWidth(): void {
      if (track) {
        setWidth = track.scrollWidth / 4;
      }
    }

    // Measure initially and on window resize
    measureSetWidth();
    window.addEventListener('resize', measureSetWidth, { passive: true });

    // 60fps RAF loop
    function step(): void {
      if (!isDragging) {
        offset -= speed;

        if (setWidth > 0) {
          if (offset <= -setWidth) {
            offset += setWidth;
          } else if (offset > 0) {
            offset -= setWidth;
          }
        }
      }

      track!.style.transform = `translate3d(${offset}px, 0, 0)`;
      requestAnimationFrame(step);
    }

    // Drag handlers
    function onPointerDown(e: PointerEvent): void {
      isDragging = true;
      startX = e.clientX;
      dragStartOffset = offset;
      viewport!.style.cursor = 'grabbing';
    }

    function onPointerMove(e: PointerEvent): void {
      if (!isDragging) return;
      const deltaX = e.clientX - startX;
      offset = dragStartOffset + deltaX;

      if (setWidth > 0) {
        if (offset <= -setWidth) {
          offset += setWidth;
          dragStartOffset += setWidth;
        } else if (offset > 0) {
          offset -= setWidth;
          dragStartOffset -= setWidth;
        }
      }
    }

    function onPointerUp(): void {
      if (!isDragging) return;
      isDragging = false;
      viewport!.style.cursor = 'grab';
    }

    viewport.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    viewport.addEventListener('pointercancel', onPointerUp);

    // Start RAF loop
    requestAnimationFrame(step);
  }

  document.addEventListener('DOMContentLoaded', initTickerEngine);
  document.addEventListener('astro:page-load', initTickerEngine);
</script>

<style>
  .marcas-ticker {
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: 2.25rem;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .marcas-ticker__viewport {
    width: 100%;
    overflow: hidden;
    cursor: grab;
    position: relative;
    touch-action: pan-y;
  }

  /* Fade gradient masks on left & right edges */
  .marcas-ticker__viewport::before,
  .marcas-ticker__viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 6rem;
    z-index: 2;
    pointer-events: none;
  }

  .marcas-ticker__viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-alt) 0%, transparent 100%);
  }

  .marcas-ticker__viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-alt) 0%, transparent 100%);
  }

  .marcas-ticker__track {
    display: flex;
    align-items: center;
    gap: 7rem;
    width: max-content;
    will-change: transform;
  }

  .marcas-ticker__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .marcas-ticker__item:hover {
    opacity: 1;
    transform: scale(1.06);
  }

  .marcas-ticker__logo {
    height: 75px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .marcas-ticker__logo svg {
    height: 75px;
    width: auto;
    display: block;
    overflow: visible;
  }
</style>
