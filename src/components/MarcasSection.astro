---
/**
 * MarcasSection Component — Continuous Infinite Drag Marquee Ticker.
 *
 * Features:
 *   - Continuous infinite movement from right to left (@keyframes marquee)
 *   - Mouse & Touch Grab/Drag support (cursor: grab -> cursor: grabbing)
 *   - Warm beige neutral strip background (#F5F3EF)
 *   - High-end monochrome logo marks for Natura Bissé, Germaine de Capuccini, Alan Coar, Artdeco, Mesoestetic
 */

interface BrandLogo {
  id: string;
  name: string;
  svgContent: string;
}

// Clean monochrome SVG logo marks with explicit width & height attributes
const brands: BrandLogo[] = [
  {
    id: 'natura-bisse',
    name: 'Natura Bissé',
    svgContent: `<svg width="200" height="60" viewBox="0 0 200 60" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="100" y="34" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="22" font-weight="600" letter-spacing="4" fill="#1A1A1A">NATURA BISSÉ</text><text x="100" y="48" text-anchor="middle" font-family="'Inter', sans-serif" font-size="8" letter-spacing="6" fill="#6B6B6B">BARCELONA</text></svg>`,
  },
  {
    id: 'germaine-de-capuccini',
    name: 'Germaine de Capuccini',
    svgContent: `<svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="120" y="32" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="18" font-weight="600" letter-spacing="3" fill="#1A1A1A">GERMAINE DE CAPUCCINI</text><text x="120" y="46" text-anchor="middle" font-family="'Inter', sans-serif" font-size="7" letter-spacing="5" fill="#6B6B6B">ALTA COSMÉTICA</text></svg>`,
  },
  {
    id: 'alan-coar',
    name: 'Alan Coar',
    svgContent: `<svg width="180" height="60" viewBox="0 0 180 60" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="90" y="34" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="24" font-weight="400" letter-spacing="5" fill="#1A1A1A">ALAN COAR</text><text x="90" y="48" text-anchor="middle" font-family="'Inter', sans-serif" font-size="7" letter-spacing="4" fill="#6B6B6B">SPECIALIST SKINCARE</text></svg>`,
  },
  {
    id: 'artdeco',
    name: 'Artdeco',
    svgContent: `<svg width="160" height="60" viewBox="0 0 160 60" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="80" y="34" text-anchor="middle" font-family="'Inter', sans-serif" font-size="22" font-weight="600" letter-spacing="6" fill="#1A1A1A">ARTDECO</text><text x="80" y="48" text-anchor="middle" font-family="'Inter', sans-serif" font-size="7" letter-spacing="5" fill="#6B6B6B">GERMANY</text></svg>`,
  },
  {
    id: 'mesoestetic',
    name: 'Mesoestetic',
    svgContent: `<svg width="200" height="60" viewBox="0 0 200 60" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="100" y="34" text-anchor="middle" font-family="'Inter', sans-serif" font-size="20" font-weight="500" letter-spacing="3" fill="#1A1A1A">mesoestetic®</text><text x="100" y="48" text-anchor="middle" font-family="'Inter', sans-serif" font-size="7" letter-spacing="4" fill="#6B6B6B">MEDICAL COSMETICS</text></svg>`,
  },
];

// Duplicate list to achieve seamless infinite loop
const doubleBrands = [...brands, ...brands, ...brands, ...brands];
---

<section class="marcas-ticker" id="firmas">
  <div class="marcas-ticker__viewport" id="ticker-viewport">
    <div class="marcas-ticker__track" id="ticker-track">
      {doubleBrands.map((brand) => (
        <div class="marcas-ticker__item" data-brand={brand.id}>
          <div class="marcas-ticker__logo" title={brand.name}>
            <Fragment set:html={brand.svgContent} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Interactive Grab/Drag & Seamless Animation Script -->
<script>
  function initTicker(): void {
    const viewport = document.getElementById('ticker-viewport');
    const track = document.getElementById('ticker-track');

    if (!viewport || !track) return;

    let isDragging = false;
    let startX = 0;

    function onPointerDown(e: PointerEvent): void {
      isDragging = true;
      startX = e.clientX;
      viewport!.style.cursor = 'grabbing';
      track!.style.animationPlayState = 'paused';
    }

    function onPointerMove(e: PointerEvent): void {
      if (!isDragging) return;
      const currentX = e.clientX;
      const diffX = currentX - startX;
      track!.style.transform = `translateX(calc(-25% + ${diffX}px))`;
    }

    function onPointerUp(): void {
      if (!isDragging) return;
      isDragging = false;
      viewport!.style.cursor = 'grab';
      track!.style.transform = '';
      track!.style.animationPlayState = 'running';
    }

    viewport.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    viewport.addEventListener('pointerleave', onPointerUp);
  }

  document.addEventListener('DOMContentLoaded', initTicker);
  document.addEventListener('astro:page-load', initTicker);
</script>

<style>
  .marcas-ticker {
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: 1.75rem;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .marcas-ticker__viewport {
    width: 100%;
    overflow: hidden;
    cursor: grab;
    position: relative;
    touch-action: pan-y;
  }

  /* Fade gradient masks on left & right edges for seamless entrance/exit */
  .marcas-ticker__viewport::before,
  .marcas-ticker__viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5rem;
    z-index: 2;
    pointer-events: none;
  }

  .marcas-ticker__viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-alt) 0%, transparent 100%);
  }

  .marcas-ticker__viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-alt) 0%, transparent 100%);
  }

  /* Track with infinite right-to-left CSS animation */
  .marcas-ticker__track {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    width: max-content;
    animation: infiniteMarquee 30s linear infinite;
    will-change: transform;
  }

  .marcas-ticker__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.75;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .marcas-ticker__item:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .marcas-ticker__logo {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marcas-ticker__logo svg {
    height: 50px;
    width: auto;
    display: block;
  }

  /* Continuous right-to-left movement animation */
  @keyframes infiniteMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .marcas-ticker__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
  }
</style>
