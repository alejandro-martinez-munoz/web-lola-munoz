---
/**
 * Navbar — High Contrast Navigation.
 */

interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: 'Inicio', href: '/#hero' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Equipo', href: '/#equipo' },
  { label: 'El Centro', href: '/#instalaciones' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="navbar" id="navbar">
  <nav class="navbar__inner container" aria-label="Navegación principal">

    <!-- Logo -->
    <a href="/#hero" class="navbar__logo" aria-label="Inicio">
      <span class="navbar__logo-text">Lola Muñoz</span>
    </a>

    <!-- Desktop navigation -->
    <ul class="navbar__links" id="nav-links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="navbar__link">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger toggle -->
    <button
      class="navbar__toggle"
      id="nav-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
    </button>

  </nav>

  <!-- Mobile menu overlay -->
  <div class="navbar__mobile" id="nav-mobile" aria-hidden="true">
    <ul class="navbar__mobile-links">
      {navLinks.map((link, i) => (
        <li style={`--stagger: ${i}`}>
          <a href={link.href} class="navbar__mobile-link">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initNavbar(): void {
    const navbar = document.getElementById('navbar');
    const toggle = document.getElementById('nav-toggle');
    const mobile = document.getElementById('nav-mobile');

    if (!navbar || !toggle || !mobile) return;

    function onScroll(): void {
      if (window.scrollY > 30) {
        navbar!.classList.add('navbar--scrolled');
      } else {
        navbar!.classList.remove('navbar--scrolled');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    let isOpen = false;

    function toggleMenu(): void {
      isOpen = !isOpen;
      toggle!.classList.toggle('navbar__toggle--active', isOpen);
      toggle!.setAttribute('aria-expanded', String(isOpen));
      mobile!.classList.toggle('navbar__mobile--open', isOpen);
      mobile!.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    function closeMenu(): void {
      if (!isOpen) return;
      isOpen = false;
      toggle!.classList.remove('navbar__toggle--active');
      toggle!.setAttribute('aria-expanded', 'false');
      mobile!.classList.remove('navbar__mobile--open');
      mobile!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', toggleMenu);
    mobile.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }

  document.addEventListener('DOMContentLoaded', initNavbar);
  document.addEventListener('astro:page-load', initNavbar);
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    transition:
      background-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      backdrop-filter var(--duration-normal) var(--ease-out);
    background: linear-gradient(180deg, rgba(44, 36, 30, 0.7) 0%, rgba(44, 36, 30, 0) 100%);
  }

  .navbar--scrolled {
    background: rgba(44, 36, 30, 0.95) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(245, 240, 232, 0.12);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5rem;
  }

  .navbar__logo {
    text-decoration: none;
    z-index: calc(var(--z-nav) + 1);
  }

  .navbar__logo-text {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2.125rem);
    font-weight: var(--weight-medium);
    color: #F9F6F0 !important;
    letter-spacing: var(--tracking-tight);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .navbar__logo:hover .navbar__logo-text {
    color: #D4B87B !important;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: calc(var(--space-md) + 0.5rem);
    list-style: none;
  }

  .navbar__link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #F9F6F0 !important;
    opacity: 0.9;
    text-decoration: none;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    position: relative;
    padding-block: 0.35rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    transition: opacity var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #D4B87B;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .navbar__link:hover {
    opacity: 1;
    color: #FFFFFF !important;
  }

  .navbar__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .navbar__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2.25rem;
    height: 2.25rem;
    background: none;
    border: none;
    cursor: pointer;
    z-index: calc(var(--z-nav) + 1);
    padding: 0;
  }

  .navbar__toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #F9F6F0;
    border-radius: var(--radius-full);
    transition:
      transform var(--duration-normal) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .navbar__toggle--active .navbar__toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .navbar__toggle--active .navbar__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .navbar__toggle--active .navbar__toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .navbar__mobile {
    position: fixed;
    inset: 0;
    z-index: var(--z-nav);
    background-color: rgba(44, 36, 30, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      visibility var(--duration-slow) var(--ease-out);
  }

  .navbar__mobile--open {
    opacity: 1;
    visibility: visible;
  }

  .navbar__mobile-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
  }

  .navbar__mobile-link {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    color: #F9F6F0;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .navbar__mobile-link:hover {
    color: #D4B87B;
  }

  @media (max-width: 840px) {
    .navbar__links {
      display: none;
    }

    .navbar__toggle {
      display: flex;
    }
  }
</style>
