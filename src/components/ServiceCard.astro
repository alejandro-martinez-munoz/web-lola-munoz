---
/**
 * ServiceCard — Crisp Warm White Card with Ultra-Readable Contrast.
 */
import type { ServiceItem } from '../data/servicios';

interface Props {
  item: ServiceItem;
  staggerIndex?: number;
}

const { item } = Astro.props;
---

<article class="service-card hover-lift" data-service-category={item.category}>
  
  <div class="service-card__main">
    <!-- Top Bar: Category Tag & Price -->
    <div class="service-card__header">
      <span class="service-card__category">{item.categoryLabel}</span>
      
      <div class="service-card__price-tag">
        <span class="service-card__price">{item.price}</span>
      </div>
    </div>

    <!-- Body: Title & Meta Info -->
    <div class="service-card__body">
      <h3 class="service-card__title">{item.title}</h3>
      
      <div class="service-card__meta">
        {item.duration && (
          <span class="service-card__duration">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            {item.duration}
          </span>
        )}

        {item.priceDetail && (
          <span class="service-card__bonus">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            {item.priceDetail}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Divider & Toggle Button -->
  <div class="service-card__actions">
    <button type="button" class="service-card__toggle-btn" aria-expanded="false" aria-label={`Ver más información sobre ${item.title}`}>
      <span class="service-card__toggle-text">Ver más info</span>
      <svg class="service-card__toggle-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- Expandable Description Drawer -->
  <div class="service-card__drawer" aria-hidden="true">
    <div class="service-card__drawer-inner">
      <p class="service-card__description">{item.description}</p>
    </div>
  </div>

</article>

<script>
  function initServiceCards(): void {
    const cards = document.querySelectorAll('.service-card');

    cards.forEach(card => {
      const btn = card.querySelector('.service-card__toggle-btn');
      const drawer = card.querySelector('.service-card__drawer') as HTMLElement | null;
      const text = card.querySelector('.service-card__toggle-text');
      
      const newBtn = btn?.cloneNode(true);
      btn?.parentNode?.replaceChild(newBtn!, btn);

      newBtn?.addEventListener('click', () => {
        if (!drawer) return;
        
        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
        
        if (isExpanded) {
          drawer.style.maxHeight = '0px';
          newBtn.setAttribute('aria-expanded', 'false');
          card.classList.remove('service-card--expanded');
          if (text) text.textContent = 'Ver más info';
        } else {
          drawer.style.maxHeight = drawer.scrollHeight + 'px';
          newBtn.setAttribute('aria-expanded', 'true');
          card.classList.add('service-card--expanded');
          if (text) text.textContent = 'Ocultar info';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initServiceCards);
  document.addEventListener('astro:page-load', initServiceCards);
</script>

<style>
  .service-card {
    background-color: #FFFFFF; /* Pure warm white background for high clarity */
    border: 1px solid rgba(44, 36, 30, 0.12);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(44, 36, 30, 0.04);
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
    overflow: hidden;
  }

  .service-card:hover {
    border-color: #967B45;
    box-shadow: 0 8px 24px rgba(44, 36, 30, 0.08);
  }

  :global(.service-card--hidden) {
    display: none !important;
  }

  .service-card__main {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .service-card__category {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: #836733;
  }

  .service-card__price-tag {
    background-color: #F5F0E8;
    border: 1px solid rgba(44, 36, 30, 0.12);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .service-card__price {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: #2C241E;
    white-space: nowrap;
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: #2C241E; /* Crisp dark brown */
    line-height: 1.25;
    margin: 0;
  }

  .service-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.15rem;
  }

  .service-card__duration,
  .service-card__bonus {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #4A3F35; /* Dark crisp text */
  }

  .service-card__bonus {
    color: #836733;
    font-weight: 600;
  }

  .service-card__actions {
    border-top: 1px solid rgba(44, 36, 30, 0.08);
    background-color: #FAFAFA;
  }

  .service-card__toggle-btn {
    width: 100%;
    background: transparent;
    border: none;
    padding: 0.65rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #2C241E; /* Very readable crisp text */
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .service-card__toggle-btn:hover {
    color: #836733;
    background-color: rgba(44, 36, 30, 0.03);
  }

  .service-card__toggle-icon {
    transition: transform var(--duration-normal) var(--ease-out);
    color: #836733;
  }

  .service-card--expanded .service-card__toggle-icon {
    transform: rotate(180deg);
  }

  .service-card--expanded .service-card__toggle-btn {
    color: #836733;
  }

  .service-card__drawer {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--duration-normal) var(--ease-out);
  }

  .service-card__drawer-inner {
    padding: 1rem 1.5rem 1.25rem 1.5rem;
    background-color: #F7F3EC; /* Light warm cream box */
    color: #2C241E;
    border-top: 1px solid rgba(44, 36, 30, 0.08);
  }

  .service-card__description {
    font-size: 0.875rem;
    color: #2C241E; /* Crisp dark brown description text */
    line-height: 1.55;
    margin: 0;
  }
</style>
