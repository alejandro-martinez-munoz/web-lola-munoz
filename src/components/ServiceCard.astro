---
/**
 * ServiceCard — Crisp Warm White Card with Ultra-Readable Contrast.
 */
import type { ServiceItem } from '../data/servicios';

interface Props {
  item: ServiceItem;
  staggerIndex?: number;
}

const { item } = Astro.props;
---

<article
  class="service-card hover-lift"
  data-service-category={item.category}
  data-category-label={item.categoryLabel}
  data-title={item.title}
  data-price={item.price}
  data-duration={item.duration || ''}
  data-price-detail={item.priceDetail || ''}
  data-description={item.description}
>
  
  <div class="service-card__main">
    <!-- Top Bar: Category Tag & Price -->
    <div class="service-card__header">
      <span class="service-card__category">{item.categoryLabel}</span>
      
      <div class="service-card__price-tag">
        <span class="service-card__price">{item.price}</span>
      </div>
    </div>

    <!-- Body: Title & Meta Info -->
    <div class="service-card__body">
      <h3 class="service-card__title">{item.title}</h3>
      
      <div class="service-card__meta">
        {item.duration && (
          <span class="service-card__duration">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 16 14"/>
            </svg>
            {item.duration}
          </span>
        )}

        {item.priceDetail && (
          <span class="service-card__bonus">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            {item.priceDetail}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Divider & Toggle Button -->
  <div class="service-card__actions">
    <button
      type="button"
      class="service-card__toggle-btn"
      aria-label={`Ver más información sobre ${item.title}`}
    >
      <span class="service-card__toggle-text">Ver más info</span>
      <svg class="service-card__toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="16"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
    </button>
  </div>

</article>

<style>
  .service-card {
    background-color: #FFFFFF; /* Pure warm white background */
    border: 1px solid rgba(44, 36, 30, 0.12);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(44, 36, 30, 0.04);
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
    overflow: hidden;
  }

  .service-card:hover {
    border-color: #967B45;
    box-shadow: 0 8px 24px rgba(44, 36, 30, 0.08);
  }

  :global(.service-card--hidden) {
    display: none !important;
  }

  .service-card__main {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .service-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .service-card__category {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: #836733;
  }

  .service-card__price-tag {
    background-color: #F5F0E8;
    border: 1px solid rgba(44, 36, 30, 0.12);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .service-card__price {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: #2C241E;
    white-space: nowrap;
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: #2C241E;
    line-height: 1.25;
    margin: 0;
  }

  .service-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.15rem;
  }

  .service-card__duration,
  .service-card__bonus {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #4A3F35;
  }

  .service-card__bonus {
    color: #836733;
    font-weight: 600;
  }

  .service-card__actions {
    border-top: 1px solid rgba(44, 36, 30, 0.08);
    background-color: #FAFAFA;
    margin-top: auto;
  }

  .service-card__toggle-btn {
    width: 100%;
    background: transparent;
    border: none;
    padding: 0.65rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #2C241E;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .service-card__toggle-btn:hover {
    color: #836733;
    background-color: rgba(44, 36, 30, 0.04);
  }

  .service-card__toggle-icon {
    color: #836733;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .service-card__toggle-btn:hover .service-card__toggle-icon {
    transform: scale(1.15);
  }
</style>

