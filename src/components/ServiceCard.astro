---
/**
 * ServiceCard Component — Ultra-clean compact card with expandable info toggle.
 *
 * Features:
 *   - Compact default state (Title, Category, Price, CTA)
 *   - Expandable details toggle (+ Ver detalles) to prevent visual clutter
 *   - Direct WhatsApp booking link
 */
import type { ServiceItem } from '../data/servicios';

interface Props {
  item: ServiceItem;
  staggerIndex?: number;
}

const { item } = Astro.props;
const hasExtraInfo = Boolean(item.description || item.priceDetail);
const whatsappMessage = `Hola Lola, me gustaría consultar disponibilidad para ${item.title}.`;
const whatsappUrl = `https://wa.me/34612345678?text=${encodeURIComponent(whatsappMessage)}`;
---

<article class="service-card hover-lift" data-service-category={item.category}>
  
  <!-- Header: Category Tag & Price Badge -->
  <div class="service-card__header">
    <div class="service-card__tags">
      <span class="service-card__category">{item.categoryLabel}</span>
      {item.badge && <span class="service-card__badge">{item.badge}</span>}
    </div>

    <div class="service-card__price-tag">
      <span class="service-card__price">{item.price}</span>
    </div>
  </div>

  <!-- Body: Title -->
  <div class="service-card__body">
    <h3 class="service-card__title">{item.title}</h3>

    <!-- Expandable Details (Hidden by default to keep UI ultra-clean) -->
    {hasExtraInfo && (
      <div class="service-card__expandable" id={`details-${item.id}`} hidden>
        {item.description && <p class="service-card__description">{item.description}</p>}
        {item.priceDetail && (
          <div class="service-card__bonus">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>{item.priceDetail}</span>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Footer: Info Toggle & WhatsApp Link -->
  <div class="service-card__footer">
    {hasExtraInfo ? (
      <button
        type="button"
        class="service-card__toggle-btn"
        data-toggle-details={`details-${item.id}`}
        aria-expanded="false"
      >
        <span class="toggle-text-more">+ Ver detalles</span>
        <span class="toggle-text-less" hidden>− Ocultar</span>
      </button>
    ) : (
      item.duration ? (
        <span class="service-card__duration">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {item.duration}
        </span>
      ) : <span></span>
    )}

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="service-card__link"
      aria-label={`Consultar ${item.title} por WhatsApp`}
    >
      <span>Consultar</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

</article>

<!-- Toggle Script -->
<script>
  function initCardToggles(): void {
    const toggleBtns = document.querySelectorAll<HTMLButtonElement>('[data-toggle-details]');

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.toggleDetails;
        if (!targetId) return;

        const detailsEl = document.getElementById(targetId);
        const textMore = btn.querySelector('.toggle-text-more') as HTMLElement;
        const textLess = btn.querySelector('.toggle-text-less') as HTMLElement;

        if (detailsEl) {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!isExpanded));

          if (isExpanded) {
            detailsEl.hidden = true;
            if (textMore) textMore.hidden = false;
            if (textLess) textLess.hidden = true;
          } else {
            detailsEl.hidden = false;
            if (textMore) textMore.hidden = true;
            if (textLess) textLess.hidden = false;
          }
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCardToggles);
  document.addEventListener('astro:page-load', initCardToggles);
</script>

<style>
  .service-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-sm);
    position: relative;
    width: 100%;
    box-sizing: border-box;
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  /* Hidden class for category JS filtering */
  :global(.service-card--hidden) {
    display: none !important;
  }

  /* Header */
  .service-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .service-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .service-card__category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-hover);
  }

  .service-card__badge {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-hover);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
  }

  .service-card__price-tag {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .service-card__price {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    white-space: nowrap;
  }

  /* Body */
  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
    line-height: 1.25;
    margin: 0;
  }

  /* Expandable Content */
  .service-card__expandable {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--color-border-light);
    animation: fadeIn 0.25s ease-out;
  }

  .service-card__description {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
  }

  .service-card__bonus {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-hover);
  }

  /* Footer */
  .service-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2xs);
    border-top: 1px dashed var(--color-border-light);
    margin-top: auto;
  }

  .service-card__toggle-btn {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .service-card__toggle-btn:hover {
    color: var(--color-accent-hover);
  }

  .service-card__duration {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    margin-left: auto;
  }

  .service-card__link svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .service-card:hover .service-card__link {
    color: var(--color-accent-hover);
  }

  .service-card:hover .service-card__link svg {
    transform: translateX(3px);
  }
</style>
