---
/**
 * ServiceCard Component — Minimalist, ultra-clean card for treatments.
 *
 * UX Refinement:
 *   - Description hidden by default to eliminate visual noise
 *   - Interactive "+ Ver más info" button that smoothly toggles description
 *   - Removed "Consultar" link for a clean, peaceful layout
 */
import type { ServiceItem } from '../data/servicios';

interface Props {
  item: ServiceItem;
  staggerIndex?: number;
}

const { item } = Astro.props;
---

<article class="service-card hover-lift" data-service-category={item.category}>
  
  <!-- Top Bar: Category & Price Tag -->
  <div class="service-card__header">
    <div class="service-card__tags">
      <span class="service-card__category">{item.categoryLabel}</span>
      {item.badge && <span class="service-card__badge">{item.badge}</span>}
    </div>

    <div class="service-card__price-tag">
      <span class="service-card__price">{item.price}</span>
    </div>
  </div>

  <!-- Body: Title & Key Meta -->
  <div class="service-card__body">
    <h3 class="service-card__title">{item.title}</h3>
    
    <div class="service-card__meta">
      {item.duration && (
        <span class="service-card__duration">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {item.duration}
        </span>
      )}

      {item.priceDetail && (
        <span class="service-card__bonus">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          {item.priceDetail}
        </span>
      )}
    </div>
  </div>

  <!-- Expandable Description Drawer (Hidden by default) -->
  <div class="service-card__drawer" id={`drawer-${item.id}`}>
    <p class="service-card__description">{item.description}</p>
  </div>

  <!-- Footer: Toggle "+ Ver más info" Button -->
  <div class="service-card__footer">
    <button
      type="button"
      class="service-card__toggle-btn"
      aria-expanded="false"
      aria-controls={`drawer-${item.id}`}
    >
      <span class="service-card__toggle-text">+ Ver más info</span>
      <svg class="service-card__toggle-icon" width="12" height="12" viewBox="0 0 16 16" fill="none">
        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

</article>

<!-- Toggle Script for Info Drawer -->
<script>
  function initCardToggles(): void {
    const cards = document.querySelectorAll<HTMLElement>('.service-card');

    cards.forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('.service-card__toggle-btn');
      const drawer = card.querySelector<HTMLElement>('.service-card__drawer');
      const btnText = card.querySelector<HTMLElement>('.service-card__toggle-text');

      if (!btn || !drawer || !btnText) return;

      btn.addEventListener('click', () => {
        const isOpen = drawer.classList.contains('service-card__drawer--open');

        if (isOpen) {
          drawer.classList.remove('service-card__drawer--open');
          btn.classList.remove('service-card__toggle-btn--active');
          btn.setAttribute('aria-expanded', 'false');
          btnText.textContent = '+ Ver más info';
        } else {
          drawer.classList.add('service-card__drawer--open');
          btn.classList.add('service-card__toggle-btn--active');
          btn.setAttribute('aria-expanded', 'true');
          btnText.textContent = '- Menos info';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCardToggles);
  document.addEventListener('astro:page-load', initCardToggles);
</script>

<style>
  .service-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-sm);
    position: relative;
    width: 100%;
    box-sizing: border-box;
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  /* Hidden class for category JS filtering */
  :global(.service-card--hidden) {
    display: none !important;
  }

  /* Header */
  .service-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .service-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .service-card__category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-hover);
  }

  .service-card__badge {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-hover);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }

  .service-card__price-tag {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .service-card__price {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    white-space: nowrap;
  }

  /* Body */
  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
    line-height: 1.25;
    margin: 0;
  }

  .service-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: 0.15rem;
  }

  .service-card__duration,
  .service-card__bonus {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service-card__bonus {
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
  }

  /* Expandable Drawer (Collapsible) */
  .service-card__drawer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease-out,
      margin-top 0.25s ease-out;
    margin-top: 0;
  }

  .service-card__drawer--open {
    max-height: 160px;
    opacity: 1;
    margin-top: 0.5rem;
  }

  .service-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    padding: 0.6rem 0.75rem;
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-md);
    border-left: 2px solid var(--color-accent);
  }

  /* Footer Button */
  .service-card__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: var(--space-xs);
    border-top: 1px dashed var(--color-border-light);
    margin-top: auto;
  }

  .service-card__toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .service-card__toggle-icon {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .service-card__toggle-btn:hover {
    color: var(--color-accent-hover);
  }

  .service-card__toggle-btn--active {
    color: var(--color-accent-hover);
  }

  .service-card__toggle-btn--active .service-card__toggle-icon {
    transform: rotate(180deg);
  }
</style>
