---
/**
 * ServiciosSection Component — Interactive Tabbed Services Catalog.
 *
 * Features:
 *   - Category tabs filter (Option A) with smooth transition
 *   - Full service catalog (Estética Avanzada, Mirada, Bienestar, Uñas, Depilación)
 *   - Clean cards with clear price tags, bonus callouts, duration badges & WhatsApp links
 *   - Pure vanilla JS interactive filtering with 0 dependencies
 */
import { CATEGORIES, SERVICIOS_LIST } from '../data/servicios';
import Button from './Button.astro';
---

<section class="section servicios" id="servicios">
  <div class="container">
    
    <!-- Section Header -->
    <div class="servicios__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Tratamientos & Tarifas</span>
      </div>
      <h2 class="servicios__title reveal reveal--up stagger-2">
        Nuestra carta de servicios
      </h2>
      <p class="servicios__subtitle reveal reveal--up stagger-3 text-balance">
        Selecciona una categoría para explorar nuestros tratamientos de estética avanzada,
        cuidados de la mirada, uñas y experiencias de relax.
      </p>
    </div>

    <!-- Category Tabs Filter (Option A) -->
    <div class="servicios__tabs-wrap reveal reveal--up stagger-3">
      <div class="servicios__tabs" role="tablist" aria-label="Categorías de servicios">
        {CATEGORIES.map((cat, i) => (
          <button
            class={`servicios__tab ${i === 0 ? 'servicios__tab--active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Services Grid -->
    <div class="servicios__grid" id="servicios-grid">
      {SERVICIOS_LIST.map((item, index) => (
        <article
          class="service-card hover-lift reveal reveal--up"
          data-service-category={item.category}
        >
          <div class="service-card__top">
            <div class="service-card__badges">
              <span class="label service-card__category">{item.categoryLabel}</span>
              {item.badge && <span class="service-card__badge">{item.badge}</span>}
            </div>

            <div class="service-card__price-box">
              <span class="service-card__price">{item.price}</span>
            </div>
          </div>

          <div class="service-card__content">
            <h3 class="service-card__title">{item.title}</h3>
            <p class="service-card__description">{item.description}</p>
            
            {item.priceDetail && (
              <p class="service-card__price-detail">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                {item.priceDetail}
              </p>
            )}
          </div>

          <div class="service-card__footer">
            {item.duration && (
              <span class="service-card__duration">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                {item.duration}
              </span>
            )}

            <a
              href={`https://wa.me/34612345678?text=Hola%20Lola,%20me%20gustar%C3%ADa%20consultar%20disponibilidad%20para%20${encodeURIComponent(item.title)}.`}
              target="_blank"
              rel="noopener noreferrer"
              class="service-card__cta"
              aria-label={`Consultar ${item.title}`}
            >
              <span>Consultar</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Consultation Callout Banner -->
    <div class="servicios__callout reveal reveal--up stagger-4">
      <div class="servicios__callout-content">
        <h3 class="servicios__callout-title">¿Dudas sobre cuál es tu tratamiento ideal?</h3>
        <p class="servicios__callout-text">
          Realizamos una valoración previa en el centro para recomendarte exactamente la técnica que mejor se adapta a tu piel.
        </p>
      </div>
      <Button
        href="https://wa.me/34612345678?text=Hola%20Lola,%20quisiera%20pedir%20asesoramiento%20personalizado."
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
      >
        Pedir Asesoramiento Sin Compromiso
      </Button>
    </div>

  </div>
</section>

<!-- Filter Script -->
<script>
  function initCategoryFilter(): void {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.servicios__tab');
    const cards = document.querySelectorAll<HTMLElement>('[data-service-category]');

    if (tabs.length === 0 || cards.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;

        // Update active tab styling
        tabs.forEach((t) => {
          t.classList.remove('servicios__tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('servicios__tab--active');
        tab.setAttribute('aria-selected', 'true');

        // Filter cards smoothly
        cards.forEach((card) => {
          const cardCategory = card.dataset.serviceCategory;

          if (category === 'all' || cardCategory === category) {
            card.style.display = 'flex';
            // Trigger animation frame for fade in
            requestAnimationFrame(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            });
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(10px)';
            card.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCategoryFilter);
  document.addEventListener('astro:page-load', initCategoryFilter);
</script>

<style>
  .servicios {
    background-color: var(--color-bg);
    position: relative;
  }

  .servicios__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .servicios__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-top: var(--space-2xs);
  }

  /* Category Tabs Filter Bar */
  .servicios__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .servicios__tabs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-bg-alt);
    padding: 0.35rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    max-width: 100%;
  }

  .servicios__tab {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .servicios__tab:hover {
    color: var(--color-text);
  }

  .servicios__tab--active {
    background-color: var(--color-accent);
    color: var(--color-bg-dark);
    font-weight: var(--weight-semibold);
    box-shadow: var(--shadow-xs);
  }

  /* Grid Layout */
  .servicios__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .servicios__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .servicios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Service Card Component */
  .service-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out);
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  .service-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .service-card__badges {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  .service-card__category {
    font-size: 0.7rem;
  }

  .service-card__badge {
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-hover);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }

  .service-card__price-box {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .service-card__price {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    color: var(--color-text);
  }

  .service-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
    line-height: 1.2;
  }

  .service-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .service-card__price-detail {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-hover);
    margin-top: 0.25rem;
  }

  .service-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-xs);
    border-top: 1px dashed var(--color-border-light);
  }

  .service-card__duration {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    margin-left: auto;
  }

  .service-card__cta svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .service-card:hover .service-card__cta {
    color: var(--color-accent-hover);
  }

  .service-card:hover .service-card__cta svg {
    transform: translateX(3px);
  }

  /* Callout Banner */
  .servicios__callout {
    margin-top: var(--space-2xl);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 768px) {
    .servicios__callout {
      flex-direction: row;
      text-align: left;
    }
  }

  .servicios__callout-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__callout-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    max-width: 50ch;
  }
</style>
