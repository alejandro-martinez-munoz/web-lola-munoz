---
/**
 * ServiciosSection Component — Clean, High-End UX Architecture.
 *
 * Structure:
 *   1. Tratamientos Estrella (6 Rich Cards for high-value treatments)
 *   2. Carta Completa de Tarifas (Spa-style minimal price list organized by tabs)
 */
import { TRATAMIENTOS_ESTRELLA, CARTA_TARIFAS } from '../data/servicios';
import Button from './Button.astro';
---

<section class="section servicios" id="servicios">
  <div class="container">
    
    <!-- Section Header -->
    <div class="servicios__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Nuestros Tratamientos</span>
      </div>
      <h2 class="servicios__title reveal reveal--up stagger-2">
        Experiencias de belleza & cuidado personal
      </h2>
      <p class="servicios__subtitle reveal reveal--up stagger-3 text-balance">
        Combinamos alta cosmética, biotecnología avanzada y técnicas de bienestar
        para ofrecerte resultados visibles en un entorno de paz.
      </p>
    </div>

    <!-- 1. FEATURED CARDS (Tratamientos Estrella) -->
    <div class="servicios__featured-grid">
      {TRATAMIENTOS_ESTRELLA.map((treatment) => (
        <article class="featured-card hover-lift reveal reveal--up">
          <div class="featured-card__header">
            <span class="label featured-card__category">{treatment.categoryLabel}</span>
            {treatment.badge && <span class="featured-card__badge">{treatment.badge}</span>}
          </div>

          <div class="featured-card__body">
            <h3 class="featured-card__title">{treatment.title}</h3>
            <p class="featured-card__description">{treatment.description}</p>
          </div>

          <div class="featured-card__footer">
            <div class="featured-card__price-box">
              <span class="featured-card__price">{treatment.price}</span>
            </div>

            <a
              href={`https://wa.me/34612345678?text=Hola%20Lola,%20me%20gustar%C3%ADa%20consultar%20informaci%C3%B3n%20sobre%20${encodeURIComponent(treatment.title)}.`}
              target="_blank"
              rel="noopener noreferrer"
              class="featured-card__link"
            >
              <span>Consultar</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- 2. FULL PRICE MENU (Carta Completa de Tarifas tipo Spa) -->
    <div class="menu-section reveal reveal--up">
      <div class="menu-section__header text-center">
        <span class="label">Carta Completa de Tarifas</span>
        <h3 class="menu-section__title">Tarifario de servicios & depilación</h3>
        <p class="menu-section__subtitle">
          Consulta todos nuestros precios por zonas y categorías de manera rápida y transparente.
        </p>
      </div>

      <!-- Category Filter Tabs for Menu -->
      <div class="menu-tabs-wrap">
        <div class="menu-tabs" role="tablist">
          {CARTA_TARIFAS.map((cat, i) => (
            <button
              class={`menu-tab ${i === 0 ? 'menu-tab--active' : ''}`}
              data-menu-tab={cat.id}
              role="tab"
              type="button"
            >
              {cat.title}
            </button>
          ))}
        </div>
      </div>

      <!-- Menu Categories Lists -->
      <div class="menu-content">
        {CARTA_TARIFAS.map((cat, i) => (
          <div
            class={`menu-panel ${i === 0 ? 'menu-panel--active' : ''}`}
            data-menu-panel={cat.id}
          >
            <div class="menu-panel__info text-center">
              <h4 class="menu-panel__title">{cat.title}</h4>
              <p class="menu-panel__subtitle">{cat.subtitle}</p>
            </div>

            <div class="menu-list">
              {cat.items.map((item) => (
                <div class={`menu-item ${item.highlight ? 'menu-item--highlight' : ''}`}>
                  <div class="menu-item__left">
                    <span class="menu-item__name">{item.name}</span>
                    {item.detail && <span class="menu-item__detail">{item.detail}</span>}
                  </div>
                  <div class="menu-item__dots"></div>
                  <div class="menu-item__right">
                    <span class="menu-item__price">{item.price}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Consultation Callout Banner -->
    <div class="servicios__callout reveal reveal--up">
      <div class="servicios__callout-content">
        <h3 class="servicios__callout-title">¿Dudas sobre qué tratamiento elegir?</h3>
        <p class="servicios__callout-text">
          Te asesoramos personalmente sin compromiso para encontrar el cuidado que mejor se adapta a ti.
        </p>
      </div>
      <Button
        href="https://wa.me/34612345678?text=Hola%20Lola,%20quisiera%20pedir%20asesoramiento%20personalizado."
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
      >
        Consultar por WhatsApp
      </Button>
    </div>

  </div>
</section>

<!-- Menu Tabs Filter Script -->
<script>
  function initMenuTabs(): void {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-menu-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-menu-panel]');

    if (tabs.length === 0 || panels.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.menuTab;

        tabs.forEach((t) => t.classList.remove('menu-tab--active'));
        panels.forEach((p) => p.classList.remove('menu-panel--active'));

        tab.classList.add('menu-tab--active');

        const activePanel = document.querySelector<HTMLElement>(`[data-menu-panel="${targetId}"]`);
        if (activePanel) {
          activePanel.classList.add('menu-panel--active');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initMenuTabs);
  document.addEventListener('astro:page-load', initMenuTabs);
</script>

<style>
  .servicios {
    background-color: var(--color-bg);
    position: relative;
  }

  .servicios__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .servicios__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-top: var(--space-2xs);
  }

  /* 1. FEATURED CARDS GRID */
  .servicios__featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  @media (min-width: 640px) {
    .servicios__featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .servicios__featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
  }

  .featured-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .featured-card__category {
    font-size: 0.7rem;
  }

  .featured-card__badge {
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-hover);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }

  .featured-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .featured-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
    line-height: 1.2;
  }

  .featured-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .featured-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);
    border-top: 1px dashed var(--color-border);
    margin-top: auto;
  }

  .featured-card__price-box {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
  }

  .featured-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-card__link svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .featured-card:hover .featured-card__link {
    color: var(--color-accent-hover);
  }

  .featured-card:hover .featured-card__link svg {
    transform: translateX(3px);
  }

  /* 2. FULL PRICE MENU SECTION (SPA STYLE) */
  .menu-section {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 768px) {
    .menu-section {
      padding: var(--space-2xl);
    }
  }

  .menu-section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: var(--space-lg);
  }

  .menu-section__title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .menu-section__subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Menu Tabs Bar */
  .menu-tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xl);
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .menu-tabs {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-bg-alt);
    padding: 0.35rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    max-width: 100%;
  }

  .menu-tab {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    padding: 0.5em 1.25em;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .menu-tab:hover {
    color: var(--color-text);
  }

  .menu-tab--active {
    background-color: var(--color-accent) !important;
    color: var(--color-bg-dark) !important;
    font-weight: var(--weight-semibold) !important;
    box-shadow: var(--shadow-xs);
  }

  /* Menu Content Panels */
  .menu-panel {
    display: none;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .menu-panel--active {
    display: flex;
    animation: fadeIn var(--duration-normal) var(--ease-out);
  }

  .menu-panel__info {
    margin-bottom: var(--space-xs);
  }

  .menu-panel__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .menu-panel__subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* SPA Menu List Lines */
  .menu-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
    max-width: 900px;
    margin-inline: auto;
    width: 100%;
  }

  @media (min-width: 768px) {
    .menu-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .menu-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.25rem;
  }

  .menu-item--highlight .menu-item__name {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .menu-item__left {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    max-width: 70%;
  }

  .menu-item__name {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.3;
  }

  .menu-item__detail {
    font-size: var(--text-xs);
    color: var(--color-accent-hover);
    font-weight: var(--weight-medium);
  }

  .menu-item__dots {
    flex-grow: 1;
    border-bottom: 1px dotted var(--color-border);
    margin-bottom: 0.25rem;
    min-width: 1rem;
  }

  .menu-item__right {
    flex-shrink: 0;
  }

  .menu-item__price {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    white-space: nowrap;
  }

  /* Callout Banner */
  .servicios__callout {
    margin-top: var(--space-2xl);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 768px) {
    .servicios__callout {
      flex-direction: row;
      text-align: left;
    }
  }

  .servicios__callout-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__callout-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    max-width: 50ch;
  }
</style>
