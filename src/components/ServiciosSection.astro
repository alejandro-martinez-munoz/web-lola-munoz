---
/**
 * ServiciosSection — Dark Luxe Interactive Tabbed Services with Show/Hide.
 *
 * Features:
 *   - Category tabs filter
 *   - Shows only first ~12 cards (4 rows × 3 cols) with fade overlay
 *   - "Ver todos los servicios" button to expand
 *   - Dark luxe cards
 */
import { CATEGORIES, SERVICIOS_LIST } from '../data/servicios';
import ServiceCard from './ServiceCard.astro';
import Button from './Button.astro';
---

<section class="bg-light section servicios" id="servicios">
  <div class="container">
    
    <!-- Section Header -->
    <div class="servicios__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Tratamientos & Tarifas</span>
      </div>
      <h2 class="servicios__title reveal reveal--up stagger-2">
        Nuestra carta de servicios
      </h2>
    </div>

    <!-- Category Tabs Filter Bar -->
    <div class="servicios__tabs-wrap reveal reveal--up stagger-3">
      <div class="servicios__tabs" role="tablist" aria-label="Categorías de servicios">
        {CATEGORIES.map((cat, i) => (
          <button
            class={`servicios__tab ${i === 0 ? 'servicios__tab--active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            type="button"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Services Grid with Collapse -->
    <div class="servicios__grid-wrapper" id="servicios-wrapper">
      <div class="servicios__grid" id="servicios-grid">
        {SERVICIOS_LIST.map((item, index) => (
          <ServiceCard item={item} staggerIndex={(index % 3) + 1} />
        ))}
      </div>
      
      <!-- Fade overlay when collapsed -->
      <div class="servicios__fade-overlay" id="servicios-fade"></div>
    </div>

    <!-- "Ver más" Button -->
    <div class="servicios__expand-wrap reveal reveal--up stagger-4" id="servicios-expand-wrap">
      <div class="shimmer-line" style="max-width: 200px; margin-inline: auto; margin-bottom: 1.5rem;"></div>
      <button type="button" class="servicios__expand-btn" id="servicios-expand-btn">
        <span id="servicios-expand-text">Ver todos los servicios</span>
        <svg class="servicios__expand-icon" id="servicios-expand-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <!-- Consultation Callout Banner -->
    <div class="servicios__callout reveal reveal--up stagger-4">
      <div class="servicios__callout-content">
        <h3 class="servicios__callout-title">¿Dudas sobre qué tratamiento elegir?</h3>
        <p class="servicios__callout-text">
          Te asesoramos sin compromiso para recomendarte lo mejor para tu piel.
        </p>
      </div>
      <Button
        href="https://wa.me/34612345678?text=Hola%20Lola,%20quisiera%20pedir%20asesoramiento%20personalizado."
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
      >
        Pedir Asesoramiento
      </Button>
    </div>

  </div>
</section>

<!-- Filter + Expand Script -->
<script>
  function initServiciosInteractions(): void {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.servicios__tab');
    const cards = document.querySelectorAll<HTMLElement>('[data-service-category]');
    const wrapper = document.getElementById('servicios-wrapper');
    const fadeOverlay = document.getElementById('servicios-fade');
    const expandBtn = document.getElementById('servicios-expand-btn');
    const expandText = document.getElementById('servicios-expand-text');
    const expandIcon = document.getElementById('servicios-expand-icon');
    const expandWrap = document.getElementById('servicios-expand-wrap');

    if (!wrapper || !expandBtn) return;

    let isExpanded = false;
    const COLLAPSED_HEIGHT = '900px'; // ~4.5 rows

    // Initial collapsed state
    wrapper.style.maxHeight = COLLAPSED_HEIGHT;
    wrapper.style.overflow = 'hidden';
    wrapper.style.position = 'relative';
    wrapper.style.transition = 'max-height 0.6s cubic-bezier(0.16, 1, 0.3, 1)';

    // Expand/Collapse toggle
    expandBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;

      if (isExpanded) {
        wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
        if (fadeOverlay) fadeOverlay.style.opacity = '0';
        if (expandText) expandText.textContent = 'Mostrar menos';
        if (expandIcon) expandIcon.style.transform = 'rotate(180deg)';
      } else {
        wrapper.style.maxHeight = COLLAPSED_HEIGHT;
        if (fadeOverlay) fadeOverlay.style.opacity = '1';
        if (expandText) expandText.textContent = 'Ver todos los servicios';
        if (expandIcon) expandIcon.style.transform = 'rotate(0deg)';
        
        // Scroll back to services section
        const section = document.getElementById('servicios');
        if (section) {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    // Category Filter
    if (tabs.length === 0 || cards.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;

        // Update active tab
        tabs.forEach((t) => {
          t.classList.remove('servicios__tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('servicios__tab--active');
        tab.setAttribute('aria-selected', 'true');

        // Filter cards
        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCategory = card.dataset.serviceCategory;

          if (category === 'all' || cardCategory === category) {
            card.classList.remove('service-card--hidden');
            visibleCount++;
          } else {
            card.classList.add('service-card--hidden');
          }
        });

        // If filtered, show all and hide expand btn
        if (category !== 'all') {
          wrapper.style.maxHeight = 'none';
          wrapper.style.overflow = 'visible';
          if (fadeOverlay) fadeOverlay.style.opacity = '0';
          if (expandWrap) expandWrap.style.display = 'none';
        } else {
          // Reset to collapsed
          isExpanded = false;
          wrapper.style.maxHeight = COLLAPSED_HEIGHT;
          wrapper.style.overflow = 'hidden';
          if (fadeOverlay) fadeOverlay.style.opacity = '1';
          if (expandWrap) expandWrap.style.display = '';
          if (expandText) expandText.textContent = 'Ver todos los servicios';
          if (expandIcon) expandIcon.style.transform = 'rotate(0deg)';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initServiciosInteractions);
  document.addEventListener('astro:page-load', initServiciosInteractions);
</script>

<style>
  .servicios {
    background-color: var(--color-bg);
    position: relative;
  }

  .servicios__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .servicios__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  /* Category Tabs Filter Bar */
  .servicios__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
    width: 100%;
  }

  .servicios__tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-bg-alt);
    padding: 0.4rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    max-width: 100%;
  }

  .servicios__tab {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-full);
    background-color: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .servicios__tab:hover {
    color: var(--color-text);
  }

  .servicios__tab--active {
    background-color: var(--color-accent) !important;
    color: var(--color-bg) !important;
    font-weight: var(--weight-semibold) !important;
    box-shadow: var(--shadow-xs);
  }

  /* Grid Layout */
  .servicios__grid-wrapper {
    position: relative;
  }

  .servicios__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    width: 100%;
  }

  @media (min-width: 640px) {
    .servicios__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .servicios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Fade overlay at the bottom of the collapsed grid */
  .servicios__fade-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(
      to top,
      var(--color-bg) 0%,
      var(--color-bg) 15%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  /* Expand button */
  .servicios__expand-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-lg);
  }

  .servicios__expand-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    background: transparent;
    border: 1.5px solid var(--color-border-accent, rgba(197, 168, 126, 0.3));
    padding: 0.75em 2em;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .servicios__expand-btn:hover {
    border-color: var(--color-accent);
    background-color: rgba(197, 168, 126, 0.06);
    box-shadow: 0 0 20px rgba(197, 168, 126, 0.1);
  }

  .servicios__expand-icon {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  /* Callout Banner */
  .servicios__callout {
    margin-top: var(--space-2xl);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 768px) {
    .servicios__callout {
      flex-direction: row;
      text-align: left;
    }
  }

  .servicios__callout-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__callout-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    max-width: 50ch;
  }
</style>
