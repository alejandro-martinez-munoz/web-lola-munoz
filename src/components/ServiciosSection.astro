---
/**
 * ServiciosSection — Dark Luxe Interactive Tabbed Services with Show/Hide.
 *
 * Features:
 *   - Category tabs filter
 *   - Shows only first ~12 cards (4 rows × 3 cols) with fade overlay
 *   - "Ver todos los servicios" button to expand
 *   - Dark luxe cards
 */
import { CATEGORIES, SERVICIOS_LIST } from '../data/servicios';
import ServiceCard from './ServiceCard.astro';
import Button from './Button.astro';
---

<section class="bg-light section servicios" id="servicios">
  <div class="container">
    
    <!-- Section Header -->
    <div class="servicios__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Tratamientos & Tarifas</span>
      </div>
      <h2 class="servicios__title reveal reveal--up stagger-2">
        Nuestra carta de servicios
      </h2>
    </div>

    <!-- Category Tabs Filter Bar -->
    <div class="servicios__tabs-wrap reveal reveal--up stagger-3">
      <div class="servicios__tabs" role="tablist" aria-label="Categorías de servicios">
        <div class="servicios__tab-indicator" id="tab-indicator" aria-hidden="true"></div>
        {CATEGORIES.map((cat, i) => (
          <button
            class={`servicios__tab ${i === 0 ? 'servicios__tab--active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            type="button"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Services Grid with Collapse -->
    <div class="servicios__grid-wrapper" id="servicios-wrapper">
      <div class="servicios__grid" id="servicios-grid">
        {SERVICIOS_LIST.map((item, index) => (
          <ServiceCard item={item} staggerIndex={(index % 3) + 1} />
        ))}
      </div>
      
      <!-- Fade overlay when collapsed -->
      <div class="servicios__fade-overlay" id="servicios-fade"></div>
    </div>

    <!-- "Ver más" Button -->
    <div class="servicios__expand-wrap reveal reveal--up stagger-4" id="servicios-expand-wrap">
      <div class="shimmer-line" style="max-width: 200px; margin-inline: auto; margin-bottom: 1.5rem;"></div>
      <button type="button" class="servicios__expand-btn" id="servicios-expand-btn">
        <span id="servicios-expand-text">Ver todos los servicios</span>
        <svg class="servicios__expand-icon" id="servicios-expand-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

  </div> <!-- Close services container -->

  <!-- Full-Width Dark Stripe Consultation Callout Banner -->
  <div class="servicios__stripe reveal reveal--up stagger-4">
    <div class="container">
      <div class="servicios__callout">
        <div class="servicios__callout-content">
          <h3 class="servicios__callout-title">¿Dudas sobre qué tratamiento elegir?</h3>
          <p class="servicios__callout-text">
            Te asesoramos sin compromiso. Llámanos para aconsejarte.
          </p>
        </div>
        <Button
          href="tel:953501451"
          variant="primary"
          size="md"
        >
          Llamar al 953 50 14 51
        </Button>
      </div>
    </div>
  </div>

  <!-- Modal de Detalle de Servicio -->
  <div class="service-modal" id="service-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="service-modal__backdrop" id="service-modal-backdrop"></div>
    <div class="service-modal__dialog">
      <button type="button" class="service-modal__close" id="service-modal-close" aria-label="Cerrar ventana">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="service-modal__header">
        <span class="service-modal__category" id="modal-category"></span>
        <div class="service-modal__price-tag">
          <span class="service-modal__price" id="modal-price"></span>
        </div>
      </div>

      <h3 class="service-modal__title" id="modal-title"></h3>

      <div class="service-modal__meta" id="modal-meta">
        <span class="service-modal__meta-item" id="modal-duration-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 16 14"/>
          </svg>
          <span id="modal-duration"></span>
        </span>
        <span class="service-modal__meta-item service-modal__bonus" id="modal-bonus-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span id="modal-bonus"></span>
        </span>
      </div>

      <div class="service-modal__divider"></div>

      <div class="service-modal__body">
        <h4 class="service-modal__subtitle">Detalles del Tratamiento</h4>
        <p class="service-modal__description" id="modal-description"></p>
      </div>

      <div class="service-modal__footer">
        <Button href="tel:953501451" variant="primary" size="md">
          Llamar para Reservar (953 50 14 51)
        </Button>
      </div>
    </div>
  </div>

</section>

<!-- Filter + Expand Script -->
<script>
  function initServiciosInteractions(): void {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.servicios__tab');
    const cards = document.querySelectorAll<HTMLElement>('[data-service-category]');
    const wrapper = document.getElementById('servicios-wrapper');
    const fadeOverlay = document.getElementById('servicios-fade');
    const expandBtn = document.getElementById('servicios-expand-btn');
    const expandText = document.getElementById('servicios-expand-text');
    const expandIcon = document.getElementById('servicios-expand-icon');
    const expandWrap = document.getElementById('servicios-expand-wrap');

    if (!wrapper || !expandBtn) return;

    let isExpanded = false;
    const COLLAPSED_HEIGHT = '900px'; // ~4.5 rows

    // Initial collapsed state
    wrapper.style.maxHeight = COLLAPSED_HEIGHT;
    wrapper.style.overflow = 'hidden';
    wrapper.style.position = 'relative';
    wrapper.style.transition = 'max-height 0.6s cubic-bezier(0.16, 1, 0.3, 1)';

    // Expand/Collapse toggle
    expandBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;

      if (isExpanded) {
        wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
        if (fadeOverlay) fadeOverlay.style.opacity = '0';
        if (expandText) expandText.textContent = 'Mostrar menos';
        if (expandIcon) expandIcon.style.transform = 'rotate(180deg)';
      } else {
        wrapper.style.maxHeight = COLLAPSED_HEIGHT;
        if (fadeOverlay) fadeOverlay.style.opacity = '1';
        if (expandText) expandText.textContent = 'Ver todos los servicios';
        if (expandIcon) expandIcon.style.transform = 'rotate(0deg)';
        
        // Scroll back to services section
        const section = document.getElementById('servicios');
        if (section) {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    // Category Filter & Liquid Water Drop Sliding Pill Indicator
    if (tabs.length === 0 || cards.length === 0) return;

    const tabsContainer = document.querySelector<HTMLElement>('.servicios__tabs');
    const indicator = document.getElementById('tab-indicator');
    let currentActiveTab = document.querySelector<HTMLElement>('.servicios__tab--active') || tabs[0];

    function updateIndicatorPosition(targetTab: HTMLElement, animate = true): void {
      if (!indicator || !tabsContainer || !targetTab) return;

      const targetRect = targetTab.getBoundingClientRect();
      const containerRect = tabsContainer.getBoundingClientRect();
      const currentRect = currentActiveTab ? currentActiveTab.getBoundingClientRect() : targetRect;

      const left = targetRect.left - containerRect.left;
      const top = targetRect.top - containerRect.top;
      const width = targetRect.width;
      const height = targetRect.height;

      if (!animate) {
        indicator.style.transition = 'none';
      } else {
        indicator.style.transition = `
          transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
          width 0.32s cubic-bezier(0.16, 1, 0.3, 1),
          height 0.32s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.2s ease
        `;
      }

      indicator.style.transform = `translate3d(${left}px, ${top}px, 0)`;
      indicator.style.width = `${width}px`;
      indicator.style.height = `${height}px`;
      indicator.style.opacity = '1';

      currentActiveTab = targetTab;
    }

    if (currentActiveTab) {
      setTimeout(() => updateIndicatorPosition(currentActiveTab, false), 30);
    }

    window.addEventListener('resize', () => {
      if (currentActiveTab) updateIndicatorPosition(currentActiveTab, false);
    });

    function getColsCount(): number {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function triggerCardsEntrance(startDelayOffset = 0): void {
      const activeTab = document.querySelector<HTMLElement>('.servicios__tab--active');
      const category = activeTab ? activeTab.dataset.category || 'all' : 'all';

      let visibleIndex = 0;

      cards.forEach((card) => {
        const cardCategory = card.dataset.serviceCategory;
        const isMatch = category === 'all' || cardCategory === category;

        if (isMatch) {
          card.classList.remove('service-card--hidden');

          // Stagger cards starting AFTER title/tabs reveal (280ms offset + 90ms per card)
          const delay = startDelayOffset + (visibleIndex * 90);

          card.style.opacity = '0';
          card.style.animation = 'none';
          void card.offsetWidth; // Force reflow
          card.style.animation = `serviceCardEnter 0.52s cubic-bezier(0.16, 1, 0.3, 1) ${delay}ms both`;

          const handleAnimEnd = () => {
            card.style.opacity = '1';
            card.style.animation = '';
            card.removeEventListener('animationend', handleAnimEnd);
          };
          card.addEventListener('animationend', handleAnimEnd);

          visibleIndex++;
        } else {
          card.classList.add('service-card--hidden');
          card.style.animation = 'none';
          card.style.opacity = '0';
        }
      });
    }

    // Scroll reveal — trigger cards animation AFTER title and tabs finish appearing
    let hasAnimatedOnScroll = false;

    function checkScrollReveal(): void {
      if (hasAnimatedOnScroll) return;
      const rect = wrapper.getBoundingClientRect();
      if (rect.top < window.innerHeight - 40) {
        hasAnimatedOnScroll = true;
        // Start cards animation 280ms AFTER section title & tabs reveal!
        triggerCardsEntrance(280);
        window.removeEventListener('scroll', checkScrollReveal);
      }
    }

    window.addEventListener('scroll', checkScrollReveal, { passive: true });
    checkScrollReveal();

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;

        // Update active tab & glide indicator
        tabs.forEach((t) => {
          t.classList.remove('servicios__tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('servicios__tab--active');
        tab.setAttribute('aria-selected', 'true');

        updateIndicatorPosition(tab, true);
        triggerCardsEntrance(0);

        // If filtered, show all and hide expand btn
        if (category !== 'all') {
          wrapper.style.maxHeight = 'none';
          wrapper.style.overflow = 'visible';
          if (fadeOverlay) fadeOverlay.style.opacity = '0';
          if (expandWrap) expandWrap.style.display = 'none';
        } else {
          // Reset to collapsed
          isExpanded = false;
          wrapper.style.maxHeight = COLLAPSED_HEIGHT;
          wrapper.style.overflow = 'hidden';
          if (fadeOverlay) fadeOverlay.style.opacity = '1';
          if (expandWrap) expandWrap.style.display = '';
          if (expandText) expandText.textContent = 'Ver todos los servicios';
          if (expandIcon) expandIcon.style.transform = 'rotate(0deg)';
        }
      });
    });

    // --- Modal Logic ---
    const modal = document.getElementById('service-modal');
    const modalBackdrop = document.getElementById('service-modal-backdrop');
    const modalClose = document.getElementById('service-modal-close');
    const modalCategory = document.getElementById('modal-category');
    const modalPrice = document.getElementById('modal-price');
    const modalTitle = document.getElementById('modal-title');
    const modalDuration = document.getElementById('modal-duration');
    const modalDurationWrap = document.getElementById('modal-duration-wrap');
    const modalBonus = document.getElementById('modal-bonus');
    const modalBonusWrap = document.getElementById('modal-bonus-wrap');
    const modalDescription = document.getElementById('modal-description');

    function openModal(card: HTMLElement): void {
      if (!modal) return;
      
      const category = card.dataset.categoryLabel || '';
      const title = card.dataset.title || '';
      const price = card.dataset.price || '';
      const duration = card.dataset.duration || '';
      const bonus = card.dataset.priceDetail || '';
      const description = card.dataset.description || '';

      if (modalCategory) modalCategory.textContent = category;
      if (modalPrice) modalPrice.textContent = price;
      if (modalTitle) modalTitle.textContent = title;
      if (modalDescription) modalDescription.textContent = description;

      if (modalDurationWrap) {
        if (duration) {
          if (modalDuration) modalDuration.textContent = duration;
          modalDurationWrap.style.display = 'inline-flex';
        } else {
          modalDurationWrap.style.display = 'none';
        }
      }

      if (modalBonusWrap) {
        if (bonus) {
          if (modalBonus) modalBonus.textContent = bonus;
          modalBonusWrap.style.display = 'inline-flex';
        } else {
          modalBonusWrap.style.display = 'none';
        }
      }

      modal.classList.add('service-modal--active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(): void {
      if (!modal) return;
      modal.classList.remove('service-modal--active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach click event to "Ver más info" button on every card
    cards.forEach((card) => {
      const btn = card.querySelector('.service-card__toggle-btn');
      if (btn) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal(card);
        });
      }
    });

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('service-modal--active')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServiciosInteractions);
  } else {
    initServiciosInteractions();
  }
  document.addEventListener('astro:page-load', initServiciosInteractions);
</script>

<style>
  .servicios {
    background-color: var(--color-bg);
    position: relative;
  }

  .servicios__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .servicios__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  /* Category Tabs Filter Bar */
  .servicios__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
    width: 100%;
  }

  .servicios__tabs {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-bg-alt);
    padding: 0.4rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    max-width: 100%;
  }

  .servicios__tab-indicator {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 1;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    box-shadow: 0 4px 14px rgba(150, 123, 69, 0.25);
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
    opacity: 0;
    will-change: transform, width, height;
  }

  .servicios__tab {
    position: relative;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-full);
    background-color: transparent !important;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.3s var(--ease-out);
  }

  .servicios__tab:hover {
    color: var(--color-text);
  }

  .servicios__tab--active {
    color: #FFFFFF !important;
    font-weight: var(--weight-semibold) !important;
  }

  /* Grid Layout */
  .servicios__grid-wrapper {
    position: relative;
    padding-top: 12px;
    margin-top: -12px;
  }

  .servicios__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    width: 100%;
  }

  @media (min-width: 640px) {
    .servicios__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .servicios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Exit animation for old cards when switching tabs */
  :global(@keyframes serviceCardExit) {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(-16px) scale(0.96);
    }
  }

  /* Staggered entrance animation for filter */
  :global(@keyframes serviceCardEnter) {
    0% {
      opacity: 0;
      transform: translateY(36px) scale(0.94);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Fade overlay at the bottom of the collapsed grid */
  .servicios__fade-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(
      to top,
      var(--color-bg) 0%,
      var(--color-bg) 15%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  /* Expand button */
  .servicios__expand-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-lg);
  }

  .servicios__expand-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    background: transparent;
    border: 1.5px solid var(--color-border-accent, rgba(197, 168, 126, 0.3));
    padding: 0.75em 2em;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .servicios__expand-btn:hover {
    border-color: var(--color-accent);
    background-color: rgba(197, 168, 126, 0.06);
    box-shadow: 0 0 20px rgba(197, 168, 126, 0.1);
  }

  .servicios__expand-icon {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  /* Callout Full-Width Dark Banner Stripe */
  .servicios__stripe {
    width: 100%;
    background-color: #2C241E;
    margin-top: var(--space-2xl);
    padding: clamp(2.5rem, 4vw, 4.5rem) 0;
    border-top: 1px solid rgba(197, 160, 89, 0.25);
    border-bottom: 1px solid rgba(197, 160, 89, 0.25);
  }

  .servicios__callout {
    margin-top: 0;
    background-color: transparent;
    border: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    text-align: center;
    box-shadow: none;
  }

  @media (min-width: 768px) {
    .servicios__callout {
      flex-direction: row;
      text-align: left;
    }
  }

  .servicios__callout-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: #FFFFFF;
  }

  .servicios__callout-text {
    font-size: var(--text-sm);
    color: #D4C9BD;
    margin-top: 0.25rem;
    max-width: 50ch;
  }

  /* Service Modal Popup */
  .service-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.2s ease-out;
  }

  .service-modal--active {
    visibility: visible;
    pointer-events: auto;
  }

  .service-modal__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(44, 36, 30, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.15s ease-out;
    will-change: opacity;
    transform: translateZ(0);
  }

  .service-modal--active .service-modal__backdrop {
    opacity: 1;
  }

  .service-modal__dialog {
    position: relative;
    z-index: 2;
    background-color: #FFFFFF;
    border: 1px solid rgba(44, 36, 30, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    width: 100%;
    max-width: 520px;
    box-shadow: 0 20px 40px rgba(44, 36, 30, 0.25);
    opacity: 0;
    transform: scale(0.95) translateY(8px);
    transition: opacity 0.2s ease-out, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 90vh;
    overflow-y: auto;
    will-change: opacity, transform;
  }

  .service-modal--active .service-modal__dialog {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .service-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid rgba(44, 36, 30, 0.12);
    background-color: #F5F0E8;
    color: #2C241E;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .service-modal__close:hover {
    background-color: var(--color-accent);
    color: #FFFFFF;
    border-color: var(--color-accent);
  }

  .service-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-right: 2.5rem;
  }

  .service-modal__category {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: #836733;
  }

  .service-modal__price-tag {
    background-color: #F5F0E8;
    border: 1px solid rgba(44, 36, 30, 0.12);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
  }

