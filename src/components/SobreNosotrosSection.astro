---
/**
 * SobreNosotrosSection — Philosophy Section with Before/After Labels.
 */
---

<section class="bg-light section sobre-nosotros" id="sobre-mi">
  <div class="container sobre-nosotros__wrapper">
    
    <!-- Left Column: Before Image (Subtle fine lines) -->
    <div class="sobre-nosotros__card-wrap">
      <div class="sobre-nosotros__img-card">
        <img
          src="/images/woman-before.png"
          alt="Antes del tratamiento - Piel natural"
          class="sobre-nosotros__img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Center Column: Statement Typography -->
    <div class="sobre-nosotros__center-content">
      <span class="sobre-nosotros__sub-header">CENTRO DE ESTÉTICA LOLA MUÑOZ</span>

      <h2 class="sobre-nosotros__main-title">
        Cada piel tiene sus necesidades: <span class="sobre-nosotros__gold-text">Revelamos tu luz natural.</span>
      </h2>

    </div>

    <!-- Right Column: After Image (Smooth radiant skin) -->
    <div class="sobre-nosotros__card-wrap">
      <div class="sobre-nosotros__img-card">
        <img
          src="/images/woman-after.png"
          alt="Después del tratamiento - Piel radiante"
          class="sobre-nosotros__img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

  </div>
</section>

<style>
  .sobre-nosotros {
    background-color: #F5F0E8 !important;
    padding-top: clamp(1.5rem, 2.5vw, 3rem) !important; /* Reduced top padding */
    padding-bottom: clamp(3.5rem, 5vw, 6rem) !important;
    position: relative;
  }

  /* 3-Column Layout */
  .sobre-nosotros__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .sobre-nosotros__wrapper {
      display: grid;
      grid-template-columns: 220px 1fr 220px;
      align-items: center;
      gap: clamp(1.5rem, 3vw, 3.5rem);
    }
  }

  @media (min-width: 1100px) {
    .sobre-nosotros__wrapper {
      grid-template-columns: 260px 1fr 260px;
    }
  }

  /* Image Column with Label */
  .sobre-nosotros__card-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 260px;
  }

  .sobre-nosotros__image-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #836733;
    background-color: rgba(131, 103, 51, 0.1);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(131, 103, 51, 0.2);
  }

  /* Image Cards with Rounded Corners */
  .sobre-nosotros__img-card {
    width: 100%;
    height: 370px;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(44, 36, 30, 0.08);
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .sobre-nosotros__img-card {
      height: 300px;
      max-width: 220px;
    }
  }

  .sobre-nosotros__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sobre-nosotros__img-card:hover .sobre-nosotros__img {
    transform: scale(1.05);
  }

  /* Center Content */
  .sobre-nosotros__center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .sobre-nosotros__sub-header {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #544941;
  }

  /* Huge Unique Title */
  .sobre-nosotros__main-title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 3.8vw, 4.25rem) !important;
    font-weight: 300 !important;
    color: #2C241E !important;
    line-height: 1.08 !important;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
  }

  .sobre-nosotros__gold-text {
    font-family: var(--font-serif);
    color: #A58F5B !important;
    font-weight: 400 !important;
    display: block;
    margin-top: 0.25rem;
  }

  .sobre-nosotros__tagline {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #544941;
    margin-top: 0.5rem;
    max-width: 44ch;
  }
</style>
