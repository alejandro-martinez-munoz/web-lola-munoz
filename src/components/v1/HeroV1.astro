---
/**
 * Hero Component (V1 Original).
 */
import Button from './ButtonV1.astro';
---

<section class="hero" id="hero">
  <div class="container hero__container">
    <div class="hero__content">
      <div class="reveal reveal--up stagger-1">
        <span class="label hero__eyebrow">Centro De Estética & Bienestar</span>
      </div>

      <h1 class="hero__title reveal reveal--up stagger-2">
        Tu espacio de <span class="text-serif-italic">belleza</span>, calma y cuidado personal.
      </h1>

      <p class="hero__description reveal reveal--up stagger-3">
        Tratamientos faciales y corporales personalizados a tu medida. Más de 10 años ofreciendo resultados visibles con máxima delicadeza.
      </p>

      <div class="hero__actions reveal reveal--up stagger-4">
        <Button href="#servicios" variant="primary" size="lg">
          Ver Tratamientos
        </Button>
        <Button href="#contacto" variant="secondary" size="lg">
          Contactar
        </Button>
      </div>

      <div class="hero__features reveal reveal--up stagger-5">
        <div class="hero__feature">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Cosmética de Alta Gama</span>
        </div>
        <div class="hero__feature-divider"></div>
        <div class="hero__feature">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
          </svg>
          <span>Atención 100% Personalizada</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(5rem + var(--space-3xl));
    padding-bottom: var(--space-3xl);
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .hero__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 800px;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-2xs);
  }

  .hero__title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-light);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  .text-serif-italic {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero__description {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 55ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .hero__features {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .hero__feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .hero__feature svg {
    color: var(--color-accent);
  }

  .hero__feature-divider {
    width: 1px;
    height: 1rem;
    background-color: var(--color-border);
  }

  @media (max-width: 640px) {
    .hero__features {
      border-radius: var(--radius-lg);
      flex-direction: column;
      gap: 0.5rem;
    }
    .hero__feature-divider {
      display: none;
    }
  }
</style>
