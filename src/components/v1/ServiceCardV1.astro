---
/**
 * ServiceCard Component (V1 Original).
 */
import type { ServiceItem } from '../../data/servicios';

interface Props {
  item: ServiceItem;
  staggerIndex?: number;
}

const { item } = Astro.props;
---

<article class="service-card hover-lift" data-service-category={item.category}>
  
  <div class="service-card__header">
    <span class="service-card__category">{item.categoryLabel}</span>
    
    <div class="service-card__price-tag">
      <span class="service-card__price">{item.price}</span>
      {item.priceDetail && (
        <span class="service-card__price-detail">{item.priceDetail}</span>
      )}
    </div>
  </div>

  <div class="service-card__body">
    <h3 class="service-card__title">{item.title}</h3>
    
    {item.duration && (
      <span class="service-card__duration">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        {item.duration}
      </span>
    )}
  </div>

  <div class="service-card__actions">
    <button type="button" class="service-card__toggle-btn" aria-expanded="false" aria-label={`Ver más información sobre ${item.title}`}>
      <span class="service-card__toggle-text">Ver más info</span>
      <svg class="service-card__toggle-icon" width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="service-card__drawer" aria-hidden="true">
    <div class="service-card__drawer-inner">
      <p class="service-card__description">{item.description}</p>
    </div>
  </div>

</article>

<script>
  function initServiceCardsV1(): void {
    const cards = document.querySelectorAll('.service-card');

    cards.forEach(card => {
      const btn = card.querySelector('.service-card__toggle-btn');
      const drawer = card.querySelector('.service-card__drawer') as HTMLElement | null;
      const text = card.querySelector('.service-card__toggle-text');
      
      const newBtn = btn?.cloneNode(true);
      btn?.parentNode?.replaceChild(newBtn!, btn);

      newBtn?.addEventListener('click', () => {
        if (!drawer) return;
        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          drawer.style.maxHeight = '0px';
          newBtn.setAttribute('aria-expanded', 'false');
          card.classList.remove('service-card--expanded');
          if (text) text.textContent = 'Ver más info';
        } else {
          drawer.style.maxHeight = drawer.scrollHeight + 'px';
          newBtn.setAttribute('aria-expanded', 'true');
          card.classList.add('service-card--expanded');
          if (text) text.textContent = 'Ocultar info';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initServiceCardsV1);
  document.addEventListener('astro:page-load', initServiceCardsV1);
</script>

<style>
  .service-card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-sm);
    position: relative;
    width: 100%;
    box-sizing: border-box;
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
    overflow: hidden;
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  :global(.service-card--hidden) {
    display: none !important;
  }

  .service-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .service-card__category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .service-card__price-tag {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .service-card__price {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .service-card__price-detail {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
    line-height: 1.2;
    margin: 0;
  }

  .service-card__duration {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service-card__actions {
    border-top: 1px solid var(--color-border);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
  }

  .service-card__toggle-btn {
    width: 100%;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .service-card__toggle-btn:hover {
    color: var(--color-text);
  }

  .service-card__drawer {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--duration-normal) var(--ease-out);
  }

  .service-card__drawer-inner {
    padding-top: 0.5rem;
  }

  .service-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }
</style>
