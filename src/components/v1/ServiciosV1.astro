---
/**
 * ServiciosSection Component (V1 Original).
 */
import { CATEGORIES, SERVICIOS_LIST } from '../../data/servicios';
import ServiceCard from './ServiceCardV1.astro';
import Button from './ButtonV1.astro';
---

<section class="section servicios" id="servicios">
  <div class="container">
    
    <!-- Section Header -->
    <div class="servicios__header text-center">
      <div class="reveal reveal--up stagger-1">
        <span class="label">Tratamientos & Tarifas</span>
      </div>
      <h2 class="servicios__title reveal reveal--up stagger-2">
        Nuestra carta de servicios
      </h2>
      <p class="servicios__subtitle reveal reveal--up stagger-3 text-balance">
        Precios claros y tratamientos adaptados a las necesidades reales de tu piel.
      </p>
    </div>

    <!-- Category Tabs Filter Bar -->
    <div class="servicios__tabs-wrap reveal reveal--up stagger-3">
      <div class="servicios__tabs" role="tablist" aria-label="Categorías de servicios">
        {CATEGORIES.map((cat, i) => (
          <button
            class={`servicios__tab ${i === 0 ? 'servicios__tab--active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            type="button"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Services Grid -->
    <div class="servicios__grid" id="servicios-grid">
      {SERVICIOS_LIST.map((item, index) => (
        <ServiceCard item={item} staggerIndex={(index % 3) + 1} />
      ))}
    </div>

    <!-- Consultation Callout Banner -->
    <div class="servicios__callout reveal reveal--up stagger-4">
      <div class="servicios__callout-content">
        <h3 class="servicios__callout-title">¿Dudas sobre qué tratamiento elegir?</h3>
        <p class="servicios__callout-text">
          Te asesoramos sin compromiso para recomendarte lo mejor para tu piel.
        </p>
      </div>
      <Button
        href="https://wa.me/34612345678?text=Hola%20Lola,%20quisiera%20pedir%20asesoramiento%20personalizado."
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
      >
        Pedir Asesoramiento
      </Button>
    </div>

  </div>
</section>

<script>
  function initServiciosFilter(): void {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.servicios__tab');
    const cards = document.querySelectorAll<HTMLElement>('[data-service-category]');

    if (tabs.length === 0 || cards.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;

        tabs.forEach((t) => {
          t.classList.remove('servicios__tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('servicios__tab--active');
        tab.setAttribute('aria-selected', 'true');

        cards.forEach((card) => {
          const cardCategory = card.dataset.serviceCategory;

          if (category === 'all' || cardCategory === category) {
            card.classList.remove('service-card--hidden');
          } else {
            card.classList.add('service-card--hidden');
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initServiciosFilter);
  document.addEventListener('astro:page-load', initServiciosFilter);
</script>

<style>
  .servicios {
    background-color: var(--color-bg);
  }

  .servicios__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .servicios__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .servicios__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
    width: 100%;
  }

  .servicios__tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-bg-alt);
    padding: 0.4rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    max-width: 100%;
  }

  .servicios__tab {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-full);
    background-color: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .servicios__tab:hover {
    color: var(--color-text);
  }

  .servicios__tab--active {
    background-color: var(--color-bg) !important;
    color: var(--color-text) !important;
    font-weight: var(--weight-semibold) !important;
    box-shadow: var(--shadow-xs);
  }

  .servicios__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    width: 100%;
  }

  @media (min-width: 640px) {
    .servicios__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .servicios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .servicios__callout {
    margin-top: var(--space-3xl);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 768px) {
    .servicios__callout {
      flex-direction: row;
      text-align: left;
    }
  }

  .servicios__callout-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--color-text);
  }

  .servicios__callout-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    max-width: 50ch;
  }
</style>
