---
/**
 * BaseLayout — Master layout for all pages.
 *
 * Includes:
 *   - SEO Meta tags (title, description, canonical, OpenGraph)
 *   - Favicon & Theme Color
 *   - Structured Data (JSON-LD BeautySalon / LocalBusiness schema)
 *   - Google Fonts preconnect & auto-loading
 *   - Global CSS imports in frontmatter for Vite optimization
 *   - Scroll-reveal initializer script
 */
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const siteName = 'Centro De Estética Lola Muñoz';
const defaultDescription = 'Centro de estética y bienestar. Tratamientos faciales, corporales y de belleza con profesionalidad y cercanía.';

const {
  title = siteName,
  description = defaultDescription,
  canonicalUrl,
} = Astro.props;

const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = canonicalUrl || Astro.url.href;

// JSON-LD Structured Data for Google LocalBusiness / BeautySalon
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: siteName,
  description: defaultDescription,
  url: canonical,
  telephone: '+34612345678',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle de la Belleza, 12, Local A',
    addressLocality: 'Madrid',
    postalCode: '28001',
    addressCountry: 'ES',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '10:00',
      closes: '14:00',
    },
  ],
  priceRange: '€€',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAFAF8" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Fonts — preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot name="header" />

    <slot />

    <slot name="footer" />

    <!-- Scroll reveal initializer -->
    <script>
      import { initScrollReveal } from '../scripts/scroll-reveal';

      // Run on initial load
      initScrollReveal();

      // Re-run on Astro view transitions
      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
