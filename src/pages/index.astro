---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ServiciosSection from '../components/ServiciosSection.astro';
import SobreNosotrosSection from '../components/SobreNosotrosSection.astro';
import EquipoSection from '../components/EquipoSection.astro';
import GaleriaSection from '../components/GaleriaSection.astro';
import ContactoSection from '../components/ContactoSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Inicio"
  description="Centro De Estética Lola Muñoz. Tu espacio de belleza, calma y tratamientos de estética avanzada en tu ciudad."
>

  <Navbar slot="header" />

  <main>
    <!-- Hero Section -->
    <Hero />

    <!-- Servicios Section -->
    <ServiciosSection />

    <!-- Sobre Nosotros Section -->
    <SobreNosotrosSection />

    <!-- Equipo Section -->
    <EquipoSection />

    <!-- Galería & Instalaciones Section -->
    <GaleriaSection />

    <!-- Contacto Section -->
    <ContactoSection />
  </main>

  <Footer slot="footer" />

</BaseLayout>

<style>
  /* Smooth scroll offset for anchor links */
  :global([id]) {
    scroll-margin-top: 5rem;
  }
</style>
