---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Inicio"
  description="Centro de estética y bienestar. Tratamientos faciales, corporales y de belleza con profesionalidad y cercanía."
>

  <Navbar slot="header" />

  <main id="inicio">

    <!-- Hero placeholder — will be replaced in Phase 4 -->
    <section class="section hero-placeholder">
      <div class="container">
        <div class="reveal reveal--up">
          <p class="label">Centro De Estética</p>
        </div>
        <h1 class="reveal reveal--up stagger-2">Lola Muñoz</h1>
        <p class="hero-subtitle reveal reveal--up stagger-3">
          Donde la belleza se encuentra con la serenidad.
          Un espacio diseñado para cuidarte.
        </p>
        <div class="buttons-demo reveal reveal--up stagger-4">
          <Button>Descubre más</Button>
          <Button variant="secondary">Contacto</Button>
        </div>
      </div>
    </section>

    <!-- Servicios placeholder — will be replaced in Phase 5 -->
    <section class="section" id="servicios">
      <div class="container">
        <p class="label reveal reveal--up">Nuestros Tratamientos</p>
        <h2 class="reveal reveal--up stagger-2">Servicios</h2>
        <p class="reveal reveal--up stagger-3">
          Tratamientos faciales, corporales y de belleza diseñados
          para realzar tu belleza natural con delicadeza.
        </p>
      </div>
    </section>

    <!-- Sobre mí placeholder — will be replaced in Phase 6 -->
    <section class="section section--alt" id="sobre-mi">
      <div class="container">
        <p class="label reveal reveal--up">Conóceme</p>
        <h2 class="reveal reveal--up stagger-2">Sobre Mí</h2>
        <p class="reveal reveal--up stagger-3">
          Con años de experiencia y una pasión genuina por el cuidado
          personal, mi misión es que te sientas bien contigo misma.
        </p>
      </div>
    </section>

    <!-- Contacto placeholder — will be replaced in Phase 7 -->
    <section class="section" id="contacto">
      <div class="container">
        <p class="label reveal reveal--up">Hablemos</p>
        <h2 class="reveal reveal--up stagger-2">Contacto</h2>
        <p class="reveal reveal--up stagger-3">
          Ven a conocernos. Estaremos encantados de atenderte.
        </p>
      </div>
    </section>

  </main>

</BaseLayout>

<style>
  /* Offset for fixed navbar */
  .hero-placeholder {
    padding-top: calc(4.5rem + var(--section-py));
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    margin-top: var(--space-md);
    max-width: 50ch;
  }

  .buttons-demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* Alternate section background */
  .section--alt {
    background-color: var(--color-bg-alt);
  }

  /* Smooth scroll offset for anchor links */
  :global([id]) {
    scroll-margin-top: 5rem;
  }
</style>
