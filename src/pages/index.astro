---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ServiciosSection from '../components/ServiciosSection.astro';
import SobreNosotrosSection from '../components/SobreNosotrosSection.astro';
---

<BaseLayout
  title="Inicio"
  description="Centro De Estética Lola Muñoz. Tu espacio de belleza, calma y tratamientos de estética avanzada en tu ciudad."
>

  <Navbar slot="header" />

  <main>
    <!-- Hero Section -->
    <Hero />

    <!-- Servicios Section -->
    <ServiciosSection />

    <!-- Sobre Nosotros Section -->
    <SobreNosotrosSection />

    <!-- Contacto placeholder — will be replaced in Phase 7 -->
    <section class="section" id="contacto">
      <div class="container">
        <p class="label reveal reveal--up">Hablemos</p>
        <h2 class="reveal reveal--up stagger-2">Contacto</h2>
        <p class="reveal reveal--up stagger-3">
          Ven a conocernos. Estaremos encantados de atenderte.
        </p>
      </div>
    </section>
  </main>

</BaseLayout>

<style>
  /* Smooth scroll offset for anchor links */
  :global([id]) {
    scroll-margin-top: 5rem;
  }
</style>
