---
import BaseLayoutV1 from '../layouts/v1/BaseLayoutV1.astro';
import NavbarV1 from '../components/v1/NavbarV1.astro';
import HeroV1 from '../components/v1/HeroV1.astro';
import MarcasV1 from '../components/v1/MarcasV1.astro';
import ServiciosV1 from '../components/v1/ServiciosV1.astro';
import SobreNosotrosV1 from '../components/v1/SobreNosotrosV1.astro';
import EquipoV1 from '../components/v1/EquipoV1.astro';
import GaleriaV1 from '../components/v1/GaleriaV1.astro';
import ContactoV1 from '../components/v1/ContactoV1.astro';
import FooterV1 from '../components/v1/FooterV1.astro';
---

<BaseLayoutV1
  title="Diseño Anterior (Blanco/Crema)"
  description="Centro De Estética Lola Muñoz — Versión Original."
>

  <!-- Quick Version Switcher Bar for Demo -->
  <div class="version-banner">
    <span>Estás viendo el <strong>Diseño V1 (Blanco Original)</strong></span>
    <a href="/" class="version-banner__link">Ver nuevo Diseño (Lidia Sánchez) →</a>
  </div>

  <NavbarV1 slot="header" />

  <main>
    <HeroV1 />
    <MarcasV1 />
    <ServiciosV1 />
    <SobreNosotrosV1 />
    <EquipoV1 />
    <GaleriaV1 />
    <ContactoV1 />
  </main>

  <FooterV1 slot="footer" />

</BaseLayoutV1>

<style>
  .version-banner {
    background-color: #3A312B;
    color: #F5F0E8;
    text-align: center;
    padding: 0.6rem 1rem;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    position: relative;
    z-index: 1000;
  }

  .version-banner__link {
    color: #D4B87B;
    text-decoration: underline;
    font-weight: 600;
  }

  .version-banner__link:hover {
    color: #FFFFFF;
  }

  :global([id]) {
    scroll-margin-top: 5rem;
  }
</style>
